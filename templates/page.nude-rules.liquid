{% layout none %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#DD1D3E">
  <meta name="rating" content="adult">
  <title>Nude Stack'd: how to play</title>
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
  <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
  <link rel="stylesheet" href="https://use.typekit.net/zmd5rwh.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@700&family=Poppins:wght@400;600;700&display=swap">
  {{ 'nude-app.css' | asset_url | stylesheet_tag }}
  <script>
    window.NUDE_CONFIG = {
      mode: 'rules',
      login: {{ '/customer_authentication/login?return_to=' | append: page.url | json }},
      logout: {{ routes.account_logout_url | json }},
      privacy: '/policies/privacy-policy',
      rulesUrl: '/pages/nude-rules',
      gameUrl: '/pages/nude',
      shopUrl: '/products/nude-stacked',
      icons: {{ 'nude-icons.svg' | asset_url | json }},
      content: {
        en: {{ 'nude-content-en.json' | asset_url | json }},
        de: {{ 'nude-content-de.json' | asset_url | json }},
        nl: {{ 'nude-content-nl.json' | asset_url | json }},
        fr: {{ 'nude-content-fr.json' | asset_url | json }},
        es: {{ 'nude-content-es.json' | asset_url | json }},
        it: {{ 'nude-content-it.json' | asset_url | json }}
      }
    };
  </script>
  <script src="{{ 'nude-app.js' | asset_url }}" defer></script>
</head>
<body>
  <div id="app" aria-live="polite"></div>
  <noscript><p style="color:#fff;padding:24px;font-family:sans-serif">Nude Stack'd needs JavaScript switched on to play.</p></noscript>
</body>
</html>
