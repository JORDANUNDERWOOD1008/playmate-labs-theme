{%- layout none -%}
{%- comment -%}
  The Sense Lab: the 5 Day Experience as one mini-game a day (five-play.js / five-play.css).
  Hidden page /pages/5-day-play, linked from the 5-Day emails as ?m=solo|met|duo&d=1..5.
  Source: ~/Desktop/Claude/fiveday-app (edit there, then build.py installs it here).
{%- endcomment -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="robots" content="noindex,nofollow">
  <meta name="theme-color" content="#F7EFE2">
  <title>The Sense Lab | Playmate Labs</title>
  <meta name="description" content="The 5 Day Experience: five senses, one small game a night.">
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{%- endif -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Homemade+Apple&family=Figtree:wght@400;900&display=swap">
  {{ 'five-play.css' | asset_url | stylesheet_tag }}
  {%- liquid
    assign p1 = all_products['nude-stacked']
    assign p2 = all_products['playmate-chocolate']
  -%}
  <script>
    window.PM5 = {
      signup: {{ '/pages/5-day-experience' | json }},
      products: [
        {%- if p1 != blank and p1.available -%}{handle: 'nude-stacked', title: {{ p1.title | json }}, url: {{ p1.url | json }}, image: {{ p1.featured_image | image_url: width: 200 | json }}, price: {{ p1.price | money | json }}, line: 'Wooden blocks, prompt cards, one blindfold. For two.'},{%- endif -%}
        {%- if p2 != blank and p2.available -%}{handle: 'playmate-chocolate', title: {{ p2.title | json }}, url: {{ p2.url | json }}, image: {{ p2.featured_image | image_url: width: 200 | json }}, price: {{ p2.price | money | json }}, line: 'Milk chocolate hearts, made to be snapped and shared.'}{%- endif -%}
      ]
    };
  </script>
  {%- comment -%} klaviyo.js comes from the Klaviyo app embed (it reads the email link's _kx so game events land on the right profile). {%- endcomment -%}
</head>
<body>
  <header class="p5-bar">
    <a class="p5-logo" href="{{ routes.root_url }}">playmate labs</a>
    <a class="p5-small-l" href="?">the sense lab</a>
  </header>
  <main id="app">
    <noscript><div class="p5-wrap"><h1 class="p5-h1">the sense lab.</h1><p class="p5-lede">The games need JavaScript switched on. The email has tonight's round written out too.</p></div></noscript>
  </main>
  <footer class="p5-foot"><b>come closer.</b>Playmate Labs · designed in the UK · 18+</footer>
  <script src="{{ 'five-play.js' | asset_url }}" defer></script>
</body>
</html>
