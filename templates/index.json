    "process": {
      "type": "flex-steps",
      "blocks": {
        "s1": {
          "type": "step",
          "settings": {
            "title": "Insight",
            "text": "<p>We start with the moment, not the product. What actually stops two people who like each other from finding their way back to one another on a Tuesday.</p>"
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "title": "Design",
            "text": "<p>Concepts are drawn in-house — structure, mechanic, packaging and tone together, because how a thing feels to open is part of whether it gets used.</p>"
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "title": "Prototype",
            "text": "<p>We build it with our manufacturing partners and hold it. Formulations, finishes and card stocks get revised until the object earns its place on a bedside table.</p>"
          }
        },
        "s4": {
          "type": "step",
          "settings": {
            "title": "Release",
            "text": "<p>Tested with real couples, then made in the UK in small runs. What does not change the evening does not ship.</p>"
          }
        }
      },
