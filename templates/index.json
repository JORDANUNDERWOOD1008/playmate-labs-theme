    "faq": {
      "type": "faq-accordion",
      "blocks": {
        "q1": {
          "type": "faq",
          "settings": {
            "question": "Is the packaging discreet?",
            "answer": "<p>Yes. Plain outer box, no branding, no product names on the label. It arrives looking like any other parcel, and your statement shows Playmate Labs.</p>",
            "open_by_default": false
          }
        },
        "q2": {
          "type": "faq",
          "settings": {
            "question": "What is actually in the chocolate?",
            "answer": "<p>Belgian chocolate with a functional blend of aphrodisiac actives. Every batch is made in the UK by artisan chocolatiers. Full ingredient and allergen information is on each product page.</p>",
            "open_by_default": false
          }
        },
        "q3": {
          "type": "faq",
          "settings": {
            "question": "Allergens?",
            "answer": "<p>Our chocolate contains milk and soya, and is produced in a kitchen that handles nuts. If you have a severe allergy, check the full declaration on the product page before ordering.</p>",
            "open_by_default": false
          }
        },
        "q4": {
          "type": "faq",
          "settings": {
            "question": "How many servings in a box?",
            "answer": "<p>Each box holds enough for one evening for two. Most couples order two or three boxes at a time, which is why the multi-box options are priced the way they are.</p>",
            "open_by_default": false
          }
        },
        "q5": {
          "type": "faq",
          "settings": {
            "question": "When will it arrive?",
            "answer": "<p>UK orders are dispatched within one working day and typically arrive in two to three. Free shipping over &pound;60.</p>",
            "open_by_default": false
          }
        },
        "q6": {
          "type": "faq",
          "settings": {
            "question": "Do you supply retailers?",
            "answer": "<p>We do. Playmate Labs is stocked by independent retailers across the UK. For trade pricing and lead times, get in touch through the wholesale enquiries form.</p>",
            "open_by_default": false
          }
        }
      },
