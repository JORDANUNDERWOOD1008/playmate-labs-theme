          "settings": {
            "title": "Insight",
            "text": "<p>We start with the moment, not the product. What actually stops two people who like each other from finding their way back to one another on a Tuesday.</p>"
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "title": "Design",
            "text": "<p>Drawn in-house. Renders, technical drawings and print-ready files, then the tone of voice that has to survive being read out loud.</p>"
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "title": "Prototype",
            "text": "<p>Built with our manufacturing partners and held in the hand. Materials, finishes and card stocks get revised until the object earns a place on a bedside table.</p>"
