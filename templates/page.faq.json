            "title": "Orders & Shipping"
          }
        },
        "b2": {
          "type": "question",
          "settings": {
            "q": "How long does shipping take?",
            "a": "Standard delivery takes 3-5 working days. Express options available at checkout. Free standard shipping on orders of £49 or more."
          }
        },
        "b3": {
          "type": "question",
          "settings": {
            "q": "How do I track my order?",
            "a": "You will receive a tracking email once your order has shipped. You can also check your order status in your account under Order History."
          }
        },
        "b4": {
          "type": "question",
          "settings": {
            "q": "Can I change or cancel my order?",
            "a": "We process orders quickly. Please contact us within 1 hour of placing your order to make changes. After this, we cannot guarantee modifications."
          }
        },
        "b5": {
          "type": "question",
          "settings": {
            "q": "Do you ship internationally?",
            "a": "Currently we ship within the UK. International shipping is coming soon. Sign up to our newsletter to be notified."
          }
        },
        "b6": {
          "type": "group",
          "settings": {
            "title": "Products & Drops"
          }
        },
        "b7": {
          "type": "question",
          "settings": {
            "q": "What is a Monthly Drop?",
            "a": "Each month we curate a limited-edition sensory kit for couples. Each drop is themed, limited in quantity and ships once per month. Once it's gone, it's gone."
          }
        },
        "b8": {
          "type": "question",
          "settings": {
            "q": "How do I get early access to drops?",
            "a": "Subscribe to our newsletter or join the Playmate Community to receive early access notifications before each drop goes public."
          }
        },
        "b9": {
          "type": "question",
          "settings": {
            "q": "Are the products safe / allergen-free?",
            "a": "All products are clearly labelled with ingredients and allergen information. Please review product pages carefully if you have specific dietary requirements or sensitivities."
          }
        },
        "b10": {
          "type": "question",
          "settings": {
            "q": "What's the difference between the experience and the kit?",
            "a": "The 5-Day Sensory Experience is our free digital programme delivered by email. The monthly drop kits are physical products: premium sensory items delivered to your door."
          }
        },
        "b11": {
          "type": "group",
          "settings": {
            "title": "Events"
          }
        },
        "b12": {
          "type": "question",
          "settings": {
            "q": "Where are your events held?",
            "a": "We currently host events in London, with Manchester and other UK cities coming soon. Exact venue details are sent after booking."
          }
        },
        "b13": {
          "type": "question",
          "settings": {
            "q": "Do I need to come as a couple?",
            "a": "Most events are designed for couples, though some community mixers welcome individuals. Check the specific event listing for details."
          }
        },
        "b14": {
          "type": "question",
          "settings": {
            "q": "What is your cancellation policy for events?",
            "a": "Full refunds are available up to 48 hours before the event. Within 48 hours, we can transfer your booking to a future event but cannot issue refunds."
          }
        },
        "b15": {
          "type": "group",
          "settings": {
            "title": "Membership & Rewards"
          }
        },
        "b16": {
          "type": "question",
          "settings": {
            "q": "How do I earn Playmate Points?",
            "a": "Earn 1 point per £1 spent, 50 points for writing a review, 200 points for referring a friend, 25 points for following us on social media, and 100 points when you subscribe to monthly drops."
          }
        },
        "b17": {
          "type": "question",
          "settings": {
            "q": "How do I redeem my points?",
            "a": "Points can be redeemed at checkout for discounts. 100 points = £1 off. Higher membership tiers unlock bonus multipliers and exclusive rewards."
          }
        },
        "b18": {
          "type": "group",
          "settings": {
            "title": "Returns & Refunds"
          }
        },
        "b19": {
          "type": "question",
          "settings": {
            "q": "What is your returns policy?",
            "a": "We offer 30-day returns on unopened, unused items in original packaging."
          }
        },
        "b20": {
          "type": "question",
          "settings": {
            "q": "How do I start a return?",
            "a": "Email us at info@playmatelabs.com with your order number and reason for return. We will send you a return label within 24 hours."
          }
        },
        "old21": {
          "type": "question",
          "settings": {
            "q": "Is the packaging discreet?",
            "a": "Yes. Plain outer box, no branding, no product names on the label. It arrives looking like any other parcel, and your statement shows Playmate Labs."
          }
        },
        "old22": {
          "type": "question",
          "settings": {
            "q": "Do you supply retailers?",
            "a": "We do. Playmate Labs is stocked by independent retailers across the UK. For trade pricing and lead times, get in touch through the wholesale enquiries form."
          }
        },
        "old23": {
          "type": "question",
          "settings": {
            "q": "What is actually in the chocolate?",
            "a": "Colombian milk chocolate (41% cocoa solids) with Liboost® Damiana, zinc, B6 and selenium. Every batch is made in the UK by artisan chocolatiers. Full ingredient and allergen information is on each product page."
          }
        },
        "old24": {
          "type": "question",
          "settings": {
            "q": "Allergens?",
            "a": "Our chocolate contains milk and soya, and is produced in a kitchen that handles nuts. If you have a severe allergy, check the full declaration on the product page before ordering."
          }
        },
        "old25": {
          "type": "question",
          "settings": {
            "q": "How many servings in a box?",
            "a": "Each box holds enough for one evening for two. Most couples order two or three boxes at a time, which is why the multi-box options are priced the way they are."
          }
        }
