{%- comment -%} Any other page (policies-style text pages, landing pages without their own template). {%- endcomment -%}
<div class="mx-auto max-w-3xl px-5 pb-24 pt-6 md:px-6 md:pt-12">
  <p class="text-[11px] uppercase tracking-[0.25em] text-muted-foreground"><a href="{{ routes.root_url }}">Home</a> › {{ page.title }}</p>
  <h1 class="font-heavy mt-8 text-4xl font-black leading-none tracking-tight text-primary sm:text-5xl md:text-6xl">{{ page.title | downcase }}.</h1>
  <div class="pm-rte mt-8">{{ page.content }}</div>
</div>
{% schema %}{ "name": "Page text", "settings": [] }{% endschema %}
