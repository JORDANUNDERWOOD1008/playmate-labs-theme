<div class="mx-auto max-w-6xl px-5 pb-24 pt-8 md:px-6 md:pt-12">
  <h1 class="font-heavy text-4xl font-black tracking-tight text-primary md:text-6xl">{{ section.settings.heading }}</h1>
  <div class="mt-10 divide-y divide-border border-y border-border">
    {%- for c in collections -%}{%- if c.products_count > 0 -%}
      <a href="{{ c.url }}" class="group flex flex-col gap-2 py-6 md:flex-row md:items-baseline md:justify-between">
        <span class="font-heavy text-3xl font-black tracking-tight text-primary transition group-hover:translate-x-2 md:text-5xl">{{ c.title | downcase }}.</span>
        <span class="font-bold text-primary">{{ c.products_count }} →</span>
      </a>
    {%- endif -%}{%- endfor -%}
  </div>
</div>
{% schema %}{ "name": "All collections", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "everything." }] }{% endschema %}
