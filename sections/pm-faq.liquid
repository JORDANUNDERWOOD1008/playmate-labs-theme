{%- comment -%} FAQ page. Each group is a "group" block followed by its "question" blocks. Also emits FAQPage schema. {%- endcomment -%}
{%- assign s = section.settings -%}
<div class="mx-auto max-w-3xl px-5 pb-24 pt-6 md:px-6 md:pt-12">
  <p class="text-[11px] uppercase tracking-[0.25em] text-muted-foreground"><a href="{{ routes.root_url }}">Home</a> › FAQ</p>
  {% render 'pm-note', text: s.note, class: 'mt-8 -rotate-2 text-xl' %}
  <h1 class="font-heavy mt-2 text-4xl font-black leading-none tracking-tight text-primary sm:text-5xl md:text-7xl">{{ s.heading }}</h1>
  <p class="mt-4 font-light text-muted-foreground">{{ s.sub }}</p>
  <nav aria-label="FAQ topics" class="no-scrollbar -mx-5 mt-8 flex gap-2 overflow-x-auto px-5 [scrollbar-width:none] md:mx-0 md:flex-wrap md:px-0">
    {%- for b in section.blocks -%}{%- if b.type == 'group' -%}
      <a href="#{{ b.settings.title | split: ' ' | first | handleize }}" class="shrink-0 whitespace-nowrap rounded-full border border-border px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.2em] text-primary">{{ b.settings.title }}</a>
    {%- endif -%}{%- endfor -%}
  </nav>
  {%- assign open = false -%}
  {%- for b in section.blocks -%}
    {%- if b.type == 'group' -%}
      {%- if open -%}</div></section>{%- endif -%}
      <section id="{{ b.settings.title | split: ' ' | first | handleize }}" class="scroll-mt-24 pt-12" {{ b.shopify_attributes }}>
        <h2 class="font-heavy text-2xl font-black tracking-tight text-primary md:text-3xl">{{ b.settings.title | downcase }}.</h2>
        <div class="mt-4 divide-y divide-border border-y border-border">
      {%- assign open = true -%}
    {%- else -%}
      <details class="group py-4" {{ b.shopify_attributes }}>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-bold">{{ b.settings.q }}<span class="shrink-0 text-xl leading-none text-primary transition group-open:rotate-45">+</span></summary>
        <p class="mt-3 pr-8 font-light leading-relaxed text-muted-foreground">{{ b.settings.a }}</p>
      </details>
    {%- endif -%}
  {%- endfor -%}
  {%- if open -%}</div></section>{%- endif -%}
  <div class="mt-16 rounded-md bg-card p-8 text-center">
    {% render 'pm-note', text: s.cta_note, class: '-rotate-2 text-lg' %}
    <h2 class="font-heavy mt-2 text-2xl font-black text-primary">{{ s.cta_heading }}</h2>
    <p class="mt-2 font-light text-muted-foreground">{{ s.cta_sub }}</p>
    <a href="/pages/contact" class="mt-6 inline-block rounded-full bg-primary px-8 py-4 text-[11px] font-bold uppercase tracking-[0.25em] text-primary-foreground">Contact us</a>
  </div>
</div>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
{%- assign first = true -%}
{%- for b in section.blocks -%}{%- if b.type == 'question' -%}{% unless first %},{% endunless %}{"@type":"Question","name":{{ b.settings.q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ b.settings.a | json }}}}{%- assign first = false -%}{%- endif -%}{%- endfor -%}
]}
</script>
{% schema %}
{
  "name": "FAQ (cinematic)",
  "settings": [
    { "type": "text", "id": "note", "label": "Note", "default": "ask us anything." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "questions." },
    { "type": "text", "id": "sub", "label": "Line", "default": "Everything you need to know about our products, drops, events and membership." },
    { "type": "text", "id": "cta_note", "label": "Box note", "default": "still wondering?" },
    { "type": "text", "id": "cta_heading", "label": "Box heading", "default": "can't find what you're looking for?" },
    { "type": "text", "id": "cta_sub", "label": "Box line", "default": "Our customer care team is here to help. We typically respond within 24 hours." }
  ],
  "blocks": [
    { "type": "group", "name": "Group heading", "settings": [{ "type": "text", "id": "title", "label": "Title" }] },
    { "type": "question", "name": "Question", "settings": [{ "type": "text", "id": "q", "label": "Question" }, { "type": "textarea", "id": "a", "label": "Answer" }] }
  ]
}
{% endschema %}
