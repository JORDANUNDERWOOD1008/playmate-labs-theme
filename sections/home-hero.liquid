{% render 'section-style', section: section %}
{% comment %}
  PLAYMATE LABS — HOMEPAGE HERO SECTION
  File: sections/home-hero.liquid
  Mobile:  tall product photo fills full viewport; copy pinned top, CTAs pinned bottom
  Desktop: landscape product photo as right-side visual; text on left
{% endcomment %}

{{ 'home.css' | asset_url | stylesheet_tag }}

<section class="hero-section" id="hero">

  {%- comment -%} ── BACKGROUND LAYERS ── {%- endcomment -%}
  <div class="hero-bg" aria-hidden="true">
    {%- liquid
  assign hs = section.settings
  assign w = hs.bg_width_desktop
  assign gutter = 100 | minus: w
-%}
{%- style -%}
  #shopify-section-{{ section.id }} .hero-section {
    --hero-backdrop: {{ hs.backdrop_color }};
    --hero-eyebrow-color: {{ hs.eyebrow_color }};
    --hero-heading-color: {{ hs.heading_text_color }};
    --hero-italic-color: {{ hs.italic_color }};
    --hero-sub-color: {{ hs.sub_color }};
    --hero-highlight-color: {{ hs.highlight_color }};
    {%- if hs.highlight_style == 'block' %}
    --hero-highlight-bg: {{ hs.highlight_bg }};
    --hero-highlight-pad: {{ hs.highlight_pad_y }}px {{ hs.highlight_pad_x }}px;
    --hero-highlight-radius: {{ hs.highlight_radius }}px;
    {%- endif %}
    --hero-trust-color: {{ hs.trust_color }};
    --hero-stars-color: {{ hs.stars_color }};
    --hero-text-offset: {{ hs.text_offset_desktop }}px;
    --hero-btn-offset: {{ hs.btn_offset_desktop }}px;
    --hero-btn-gap: {{ hs.btn_gap }}px;
    --hero-btn-padding: {{ hs.btn_pad_y }}px {{ hs.btn_pad_x }}px;
    --hero-btn-fontsize: {{ hs.btn_font_size }}px;
  }
  {%- comment -%} Buttons: the theme's .btn classes carry no colour controls,
      so paint them here from the section's own settings. {%- endcomment -%}
  #shopify-section-{{ section.id }} .hero-actions .btn-gold {
    background-color: {{ hs.btn1_bg }};
    color: {{ hs.btn1_label_color }};
    border: 1px solid {{ hs.btn1_border | default: hs.btn1_bg }};
  }
  #shopify-section-{{ section.id }} .hero-actions .btn-ghost {
    background-color: {{ hs.btn2_bg }};
    color: {{ hs.btn2_label_color }};
    border: 1px solid {{ hs.btn2_border | default: hs.btn2_label_color }};
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .hero-section {
      {%- if hs.eyebrow_color_mobile != blank %}--hero-eyebrow-color: {{ hs.eyebrow_color_mobile }};{% endif %}
      {%- if hs.heading_color_mobile != blank %}--hero-heading-color: {{ hs.heading_color_mobile }};{% endif %}
      {%- if hs.italic_color_mobile != blank %}--hero-italic-color: {{ hs.italic_color_mobile }};{% endif %}
      {%- if hs.sub_color_mobile != blank %}--hero-sub-color: {{ hs.sub_color_mobile }};{% endif %}
      {%- if hs.highlight_color_mobile != blank %}--hero-highlight-color: {{ hs.highlight_color_mobile }};{% endif %}
      {%- if hs.highlight_style == 'block' %}--hero-highlight-pad: {{ hs.highlight_pad_y_mobile }}px {{ hs.highlight_pad_x_mobile }}px;{% endif %}
      {%- if hs.trust_color_mobile != blank %}--hero-trust-color: {{ hs.trust_color_mobile }};{% endif %}
      {%- if hs.stars_color_mobile != blank %}--hero-stars-color: {{ hs.stars_color_mobile }};{% endif %}
      --hero-text-offset: {{ hs.text_offset_mobile }}px;
      --hero-btn-offset: {{ hs.btn_offset_mobile }}px;
      --hero-top-space: {{ hs.top_space_mobile }}%;
      --hero-btn-space: {{ hs.btn_space_mobile }}%;
      {%- if hs.btn_side_by_side_mobile %}
      --hero-btn-direction: row;
      --hero-btn-width: auto;
      --hero-btn-maxwidth: none;
      {%- endif %}
      --hero-btn-padding: {{ hs.btn_pad_y_mobile }}px {{ hs.btn_pad_x_mobile }}px;
      --hero-btn-fontsize: {{ hs.btn_font_size_mobile }}px;
    }
  }
  #shopify-section-{{ section.id }} .hero-bg-desktop {
    --hero-img-width: {{ w }}%;
    {%- if hs.bg_align_desktop == 'left' %}
    --hero-img-left: 0; --hero-img-right: auto;
    {%- else %}
    --hero-img-left: auto; --hero-img-right: 0;
    {%- endif %}
  }
  {%- comment -%}
    Per-element visibility. Hiding with CSS rather than skipping the markup
    keeps the copy in the theme editor and in the page source, so the desktop
    version and search engines still see it.
  {%- endcomment -%}
  @media (max-width: 768px) {
    {%- unless hs.show_eyebrow_mobile %}
    #shopify-section-{{ section.id }} .hero-eyebrow { display: none; }
    {%- endunless %}
    {%- unless hs.show_sub_mobile %}
    #shopify-section-{{ section.id }} .hero-sub { display: none; }
    {%- endunless %}
    {%- unless hs.show_trust_mobile %}
    #shopify-section-{{ section.id }} .hero-trust { display: none; }
    {%- endunless %}
  }
  @media (min-width: 769px) {
    {%- unless hs.show_eyebrow_desktop %}
    #shopify-section-{{ section.id }} .hero-eyebrow { display: none; }
    {%- endunless %}
    {%- unless hs.show_sub_desktop %}
    #shopify-section-{{ section.id }} .hero-sub { display: none; }
    {%- endunless %}
    {%- unless hs.show_trust_desktop %}
    #shopify-section-{{ section.id }} .hero-trust { display: none; }
    {%- endunless %}
  }

  {%- comment -%}
    Pinned mode. In normal block flow the buttons sit after the copy, so
    nudging the copy down drags them with it — and past the bottom of the
    photo. Stretching the copy column to the full height and pushing the two
    blocks apart fixes the buttons to the bottom, leaving the headline free
    to move independently above them.
  {%- endcomment -%}
  {%- if hs.pin_buttons_mobile -%}
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .hero-content-wrap { justify-content: stretch; }
    #shopify-section-{{ section.id }} .hero-content-wrap > .container {
      display: flex; flex-direction: column; flex: 1;
    }
    #shopify-section-{{ section.id }} .hero-inner { display: flex; flex-direction: column; flex: 1; }
    #shopify-section-{{ section.id }} .hero-text {
      display: flex; flex-direction: column; flex: 1;
      justify-content: {{ hs.mobile_copy_distribution }};
      {%- unless hs.mobile_copy_distribution == 'space-between' %}
      gap: {{ hs.copy_gap_mobile }}px;
      {%- endunless %}
    }
    {%- comment -%} the old 70% spacer is what pinning replaces {%- endcomment -%}
    #shopify-section-{{ section.id }} .hero-copy-bottom { padding-top: 0; }
    {%- if hs.mobile_copy_distribution == 'space-between' %}
    #shopify-section-{{ section.id }} .hero-copy-bottom { padding-top: 1.25rem; }
    {%- endif %}
  }
  {%- endif -%}

  {%- comment -%} Mobile keeps the photo full-bleed {%- endcomment -%}
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .hero-bg-desktop {
      --hero-img-width: 100%; --hero-img-left: 0; --hero-img-right: 0;
    }
  }
{%- endstyle -%}

{%- comment -%}
      Desktop bg: merchant image when set, otherwise the packaged photo.
      Served through Shopify's CDN with a srcset so large screens are not
      handed the same file as small ones.
    {%- endcomment -%}
    <div class="hero-bg-desktop">
      {%- if section.settings.hero_bg_image != blank -%}
        {%- assign img = section.settings.hero_bg_image -%}
        <img class="hero-bg-img-desktop"
             src="{{ img | image_url: width: 1800 }}"
             srcset="{{ img | image_url: width: 1000 }} 1000w,
                     {{ img | image_url: width: 1400 }} 1400w,
                     {{ img | image_url: width: 1800 }} 1800w,
                     {{ img | image_url: width: 2400 }} 2400w"
             sizes="100vw"
             width="{{ img.width }}" height="{{ img.height }}"
             alt="{{ img.alt | escape }}"
             loading="eager" fetchpriority="high">
      {%- else -%}
        <img class="hero-bg-img-desktop"
             src="{{ 'hero-desktop-product.jpg' | asset_url }}"
             alt="" width="1800" loading="eager" fetchpriority="high">
      {%- endif -%}
    </div>
    {%- comment -%} Mobile bg: tall portrait photo fills viewport {%- endcomment -%}
    <div class="hero-bg-mobile">
      {%- if section.settings.mobile_hero_image != blank -%}
        {%- assign mimg = section.settings.mobile_hero_image -%}
        <img class="hero-bg-img-mobile"
             src="{{ mimg | image_url: width: 900 }}"
             srcset="{{ mimg | image_url: width: 600 }} 600w,
                     {{ mimg | image_url: width: 900 }} 900w,
                     {{ mimg | image_url: width: 1200 }} 1200w"
             sizes="100vw"
             width="{{ mimg.width }}" height="{{ mimg.height }}"
             alt="{{ mimg.alt | escape }}"
             loading="eager" fetchpriority="high">
      {%- else -%}
        <img class="hero-bg-img-mobile"
             src="{{ 'hero-mobile-product-xtall.jpg' | asset_url }}"
             alt="" width="900" loading="eager" fetchpriority="high">
      {%- endif -%}
    </div>
    {%- comment -%} Gradient overlay (mobile only — desktop uses none) {%- endcomment -%}
    <div class="hero-gradient"></div>
  </div>

  {%- comment -%} ── CONTENT ── {%- endcomment -%}
  <div class="hero-content-wrap">
    <div class="container hero-inner">

      {%- comment -%} LEFT / TOP: All text copy {%- endcomment -%}
      <div class="hero-text">

        {%- comment -%} TOP COPY — eyebrow, headline, description {%- endcomment -%}
        <div class="hero-copy-top animate-fadeInUp">
          <p class="hero-eyebrow animate-fadeInUp animate-delay-1">
            {{ section.settings.eyebrow | default: 'A new culture of connection' }}
          </p>
          <h1 class="hero-headline animate-fadeInUp animate-delay-2">
            {{ section.settings.headline | default: 'Rewriting how <em>couples</em> do date night.' }}
          </h1>
          <p class="hero-sub animate-fadeInUp animate-delay-3">
            {{ section.settings.subheadline | default: 'Novel intimate sensory experiences, monthly date night drops, immersive events and playful rituals for modern relationships.' }}
          </p>
        </div>

        {%- comment -%} BOTTOM COPY — buttons + trust {%- endcomment -%}
        <div class="hero-copy-bottom animate-fadeInUp animate-delay-4">
          <div class="hero-actions">
            {%- comment -%}
              Was hardwired to open the 5-Day Experience modal regardless of
              what the button said — so a button reading "Shop all" opened a
              sign-up for something that is not on sale. It follows its own
              link now; tick the setting below to bring the modal back.
            {%- endcomment -%}
            {%- if section.settings.cta_primary_opens_modal -%}
              <button type="button" class="btn btn-gold btn-xl" id="heroExpBtn"
                      onclick="document.getElementById('expSignupModal').classList.add('exp-modal--open')">
                {{ section.settings.cta_primary_text | default: 'Join the list' }}
              </button>
            {%- else -%}
              <a href="{{ section.settings.cta_primary_url | default: '/collections/all' }}"
                 class="btn btn-gold btn-xl">
                {{ section.settings.cta_primary_text | default: 'Shop the range' }}
              </a>
            {%- endif -%}
            <a href="{{ section.settings.cta_secondary_url | default: '/collections/monthly-drops' }}"
               class="btn btn-ghost btn-xl">
              {{ section.settings.cta_secondary_text | default: 'Shop the Latest Drop' }}
            </a>
          </div>
          <div class="hero-trust animate-fadeInUp animate-delay-5">
            <div class="hero-trust-item">
              <div class="star-rating">★★★★★</div>
              <span>{{ section.settings.trust_rating | default: '4.9 / 5 — 2,400+ couples' }}</span>
            </div>
            <span class="hero-trust-dot">·</span>
            <div class="hero-trust-item">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
              </svg>
              <span>{{ section.settings.trust_shipping | default: 'Free shipping over £60' }}</span>
            </div>
          </div>
        </div>

      </div>{%- comment -%}/.hero-text{%- endcomment -%}



    </div>
  </div>

  <div class="hero-scroll-hint">
    <div class="scroll-dot"></div>
  </div>
</section>

<!-- ── 5-Day Experience Sign-Up Modal ─────────────────────────────── -->
<div class="exp-modal" id="expSignupModal" role="dialog" aria-modal="true" aria-label="Start the 5-Day Experience">
  <div class="exp-modal__backdrop" onclick="document.getElementById('expSignupModal').classList.remove('exp-modal--open')"></div>
  <div class="exp-modal__box">
    <button class="exp-modal__close" aria-label="Close"
            onclick="document.getElementById('expSignupModal').classList.remove('exp-modal--open')">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>

    <p class="label" style="color:var(--gold);margin-bottom:0.5rem;">It's Free. It's For You.</p>
    <h3 style="font-family:var(--font-serif);font-size:1.75rem;color:var(--cream);margin-bottom:0.25rem;">Unlock the<br>5-Day Experience</h3>
    <p style="font-size:0.875rem;color:rgba(245,239,230,0.6);margin-bottom:1.5rem;">Join 14,000+ couples who've already started.</p>

    <form class="exp-form" data-form="experience-modal">
      <div class="form-group" style="margin-bottom:0.75rem;">
        <input class="form-input form-input-dark" type="email" name="email" placeholder="Your email address" required>
      </div>
      <div class="form-group" style="margin-bottom:0.75rem;">
        <input class="form-input form-input-dark" type="tel" name="phone" placeholder="Phone number (optional SMS drops)">
      </div>
      <div class="form-group" style="margin-bottom:1.25rem;">
        <select class="form-input form-input-dark form-select" name="status">
          <option value="">I am joining as... (optional)</option>
          <option>A couple looking for novelty</option>
          <option>Dating and exploring</option>
          <option>Buying as a gift for someone</option>
        </select>
      </div>
      <button type="submit" class="btn btn-gold btn-lg" style="width:100%;justify-content:center;">
        <i class="fas fa-unlock-alt" style="margin-right:0.5rem;"></i>
        Join the list
      </button>
    </form>

    <div class="form-success" style="display:none;text-align:center;padding:2rem 0;">
      <div style="font-size:2.5rem;margin-bottom:1rem;">🎉</div>
      <h4 style="font-family:var(--font-serif);font-size:1.25rem;color:var(--cream);margin-bottom:0.5rem;">You're in!</h4>
      <p style="font-size:0.875rem;color:rgba(245,239,230,0.65);">Day 1: Curiosity arrives in your inbox tomorrow morning.</p>
    </div>

    <p style="font-size:0.6875rem;color:rgba(245,239,230,0.3);text-align:center;margin-top:1rem;">
      No spam. Unsubscribe anytime. We respect your inbox.
    </p>
  </div>
</div>

<style>
/* ── Experience sign-up modal ── */
.exp-modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 9999;
  align-items: center;
  justify-content: center;
  padding: 1rem;
}
.exp-modal--open {
  display: flex;
}
.exp-modal__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(10,3,8,0.75);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}
.exp-modal__box {
  position: relative;
  z-index: 1;
  background: linear-gradient(145deg, #2D1020 0%, #1a0a14 100%);
  border: 1px solid rgba(201,169,110,0.2);
  border-radius: var(--radius-xl, 1.25rem);
  padding: 2.5rem 2rem 2rem;
  width: 100%;
  max-width: 440px;
  box-shadow: 0 24px 64px rgba(0,0,0,0.55);
  animation: modalSlideUp 0.32s cubic-bezier(0.25,0.46,0.45,0.94);
}
@keyframes modalSlideUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0);    }
}
.exp-modal__close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 50%;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(245,239,230,0.7);
  cursor: pointer;
  transition: background 0.2s;
}
.exp-modal__close:hover {
  background: rgba(255,255,255,0.12);
  color: var(--cream, #f5efe6);
}
</style>

<script>
(function(){
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') {
      document.getElementById('expSignupModal').classList.remove('exp-modal--open');
    }
  });
})();
</script>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Background Images"
    },
    {
      "type": "image_picker",
      "id": "hero_bg_image",
      "label": "Desktop background image (landscape, optional override)"
    },
    {
      "type": "image_picker",
      "id": "mobile_hero_image",
      "label": "Mobile background image (portrait, optional override)"
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "A new culture of connection"
    },
    {
      "type": "richtext",
      "id": "headline",
      "label": "Headline (supports em for italic)",
      "default": "<p>Rewriting how <em>couples</em> do date night.</p>"
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Novel intimate sensory experiences, monthly date night drops, immersive events and playful rituals for modern relationships."
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Primary CTA text",
      "default": "Start the 5-Day Experience"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "checkbox",
      "id": "cta_primary_opens_modal",
      "label": "Primary button opens the sign-up modal",
      "default": false,
      "info": "Off: the button follows its link. On: it opens the 5-Day Experience modal."
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Secondary CTA text",
      "default": "Shop the Latest Drop"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "text",
      "id": "trust_rating",
      "label": "Trust signal — rating",
      "default": "4.9 / 5 — 2,400+ couples"
    },
    {
      "type": "text",
      "id": "trust_shipping",
      "label": "Trust signal — shipping",
      "default": "Free shipping over £60"
    },
    {
      "type": "header",
      "content": "🖼️ Photo panel (desktop)"
    },
    {
      "type": "range",
      "id": "bg_width_desktop",
      "min": 40,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Photo width",
      "default": 100,
      "info": "Below 100% the backdrop shows through beside it — that is where the copy goes."
    },
    {
      "type": "select",
      "id": "bg_align_desktop",
      "label": "Photo side",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "color",
      "id": "backdrop_color",
      "label": "Backdrop",
      "default": "#0c0408",
      "info": "Set this to white when the photo is a packshot on white."
    },
    {
      "type": "header",
      "content": "🎨 Text colours"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow — desktop",
      "default": "#C9A96E"
    },
    {
      "type": "color",
      "id": "eyebrow_color_mobile",
      "label": "Eyebrow — mobile",
      "info": "Leave blank to use the desktop colour."
    },
    {
      "type": "color",
      "id": "heading_text_color",
      "label": "Headline — desktop",
      "default": "#F5EFE6"
    },
    {
      "type": "color",
      "id": "heading_color_mobile",
      "label": "Headline — mobile",
      "info": "Leave blank to use the desktop colour."
    },
    {
      "type": "color",
      "id": "italic_color",
      "label": "Headline italic word — desktop",
      "default": "#DFC08A"
    },
    {
      "type": "color",
      "id": "italic_color_mobile",
      "label": "Headline italic word — mobile",
      "info": "Leave blank to use the desktop colour."
    },
    {
      "type": "color",
      "id": "sub_color",
      "label": "Subheadline — desktop",
      "default": "#ADA69C"
    },
    {
      "type": "color",
      "id": "sub_color_mobile",
      "label": "Subheadline — mobile",
      "info": "Leave blank to use the desktop colour."
    },
    {
      "type": "select",
      "id": "highlight_style",
      "label": "Highlighted word style",
      "options": [
        {
          "value": "colour",
          "label": "Coloured text"
        },
        {
          "value": "block",
          "label": "Highlighter block behind it"
        }
      ],
      "default": "colour",
      "info": "Bold a word in the headline (⌘B) to mark it."
    },
    {
      "type": "color",
      "id": "highlight_bg",
      "label": "Highlighter colour",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "highlight_pad_x",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Highlighter width padding — desktop",
      "default": 12
    },
    {
      "type": "range",
      "id": "highlight_pad_y",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Highlighter height padding — desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "highlight_pad_x_mobile",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Highlighter width padding — mobile",
      "default": 8
    },
    {
      "type": "range",
      "id": "highlight_pad_y_mobile",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Highlighter height padding — mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "highlight_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Highlighter corner radius",
      "default": 0
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlighted word — text",
      "default": "#C9A96E",
      "info": "Bold a word in the headline (⌘B) and it takes this colour. Italic (⌘I) takes the italic colour above."
    },
    {
      "type": "color",
      "id": "highlight_color_mobile",
