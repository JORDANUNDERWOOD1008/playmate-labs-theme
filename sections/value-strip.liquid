{% render 'section-style', section: section %}
<!-- VALUE STRIP -->
{%- comment -%}
  Block-driven so the pillars can be added, reordered and reworded in the
  editor. Claims the business cannot currently deliver do not belong here,
  and hardcoding them made that impossible to fix without a deploy.
{%- endcomment -%}
<section class="value-strip">
  <div class="container">
    <div class="value-strip-inner">
      {%- for block in section.blocks -%}
        <div class="value-strip-item reveal" data-delay="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="vs-icon">{{ block.settings.icon }}</div>
          {%- endif -%}
          <div>
            {%- if block.settings.title != blank -%}<h4>{{ block.settings.title }}</h4>{%- endif -%}
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

