{% render 'section-style', section: section %}
<!-- SOCIAL PROOF / TESTIMONIALS -->
<section class="section social-proof" id="social-proof">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-eyebrow">What Couples Say</span>
      <h2 class="heading-xl">Real couples,<br>real evenings.</h2>
      <div class="section-divider"></div>
    </div>

    {%- comment -%}
      Block-driven so the quotes can be kept current. Three of them cited
      products that are no longer on sale, and being hardcoded there was no way
      to fix that without a deploy.
    {%- endcomment -%}
    <div class="testimonials-grid">
      {%- for block in section.blocks -%}
        <div class="testimonial-card reveal" data-delay="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.stars > 0 -%}
            <div class="star-rating" style="margin-bottom:1rem;font-size:1rem;">
              {%- for i in (1..block.settings.stars) -%}★{%- endfor -%}
            </div>
          {%- endif -%}
          {%- if block.settings.quote != blank -%}
            <p class="testimonial-quote">{{ block.settings.quote }}</p>
          {%- endif -%}
          <div class="testimonial-author">
            {%- if block.settings.initials != blank -%}
              <div class="testimonial-avatar">{{ block.settings.initials }}</div>
            {%- endif -%}
            <div>
              {%- if block.settings.name != blank -%}
                <p class="testimonial-name">{{ block.settings.name }}</p>
              {%- endif -%}
              {%- if block.settings.detail != blank -%}
                <p class="testimonial-detail">{{ block.settings.detail }}</p>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

