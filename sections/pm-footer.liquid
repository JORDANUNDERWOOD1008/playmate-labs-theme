{%- comment -%} Cinematic footer: burgundy block, products column and a links column. {%- endcomment -%}
<footer class="mt-12 bg-primary px-6 pb-10 pt-20 text-primary-foreground">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-10 md:grid-cols-4">
    <div class="col-span-2">
      <img src="{{ 'pm-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1024" height="190" loading="lazy" class="h-8 w-auto">
      <p class="font-hand mt-6 text-2xl">{{ section.settings.note }}</p>
    </div>
    <div class="space-y-3 text-sm">
      <p class="text-[11px] font-bold uppercase tracking-[0.25em] opacity-70">{{ section.settings.shop_heading }}</p>
      {%- assign shop_list = section.settings.shop_collection.products | default: collections.all.products -%}
      {%- comment -%} Sold-out products (e.g. Melt'd, discontinued) are left out. {%- endcomment -%}
      {%- assign shown = 0 -%}
      {%- for p in shop_list -%}{%- if p.available and shown < 6 -%}{%- assign shown = shown | plus: 1 -%}
        <a href="{{ p.url }}" class="block">{{ p.title }}</a>
      {%- endif -%}{%- endfor -%}
    </div>
    <div class="space-y-3 text-sm">
      <p class="text-[11px] font-bold uppercase tracking-[0.25em] opacity-70">{{ section.settings.links_heading }}</p>
      {%- assign rows = section.settings.links | newline_to_br | split: '<br />' -%}
      {%- for r in rows -%}{%- assign l = r | strip | split: '|' -%}
        {%- if l[1] -%}<a href="{{ l[1] | strip }}" class="block">{{ l[0] | strip }}</a>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <div class="mx-auto mt-16 flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 text-[11px] uppercase tracking-[0.25em] opacity-60">
    <p>{{ section.settings.legal }}</p>
    {%- for policy in shop.policies -%}
      <a href="{{ policy.url }}">{{ policy.title }}</a>
    {%- endfor -%}
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "note", "label": "Handwritten line", "default": "come closer." },
    { "type": "text", "id": "shop_heading", "label": "Products heading", "default": "Shop" },
    { "type": "collection", "id": "shop_collection", "label": "Products to list", "info": "Empty = every product." },
    { "type": "text", "id": "links_heading", "label": "Links heading", "default": "Playmate" },
    { "type": "textarea", "id": "links", "label": "Links, one per line as Label|/url", "default": "About us|/pages/about\nGames|/collections/games\nCouples chocolate|/collections/couples-chocolate-collection\nJournal|/blogs/the-playmate-journal\nContact|/pages/contact\n5 Day Experience|/pages/5-day-experience\nBecome a Playmate|/pages/playmates\nFAQ|/pages/faq\nBecome a stockist|/pages/stockists" },
    { "type": "text", "id": "legal", "label": "Legal line", "default": "© Playmate Labs · Designed in the UK" }
  ]
}
{% endschema %}
