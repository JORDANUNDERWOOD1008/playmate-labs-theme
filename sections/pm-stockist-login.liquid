{%- comment -%}
  Stockist sign in (/pages/stockist-login), the cinematic "welcome back." page. Shopify's new customer
  accounts sign people in with an emailed code (no passwords), so this page hands over to Shopify's
  sign-in and brings them back to /pages/wholesale.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign back = '/pages/wholesale' -%}
{%- assign login = routes.account_login_url | append: '?return_url=' | append: back | append: '&return_to=' | append: back -%}
<div class="mx-auto max-w-5xl px-5 py-10 md:py-16">
  {% render 'pm-note', text: s.note, class: 'text-lg -rotate-2' %}
  <h1 class="font-heavy mt-4 text-4xl font-black leading-tight text-primary md:text-6xl">{{ s.heading }}</h1>
  <div class="mt-8">
    {%- if customer -%}
      <p class="max-w-xl text-muted-foreground">You're signed in as {{ customer.email }}.</p>
      <a href="{{ back }}" class="mt-6 inline-flex min-h-12 items-center justify-center rounded-full bg-primary px-8 text-[11px] font-bold uppercase tracking-[0.25em] text-primary-foreground">Wholesale account</a>
    {%- else -%}
      <p class="max-w-xl text-muted-foreground">{{ s.text }}</p>
      <a href="{{ login }}" class="mt-6 inline-flex min-h-12 w-full max-w-md items-center justify-center rounded-full bg-primary px-8 text-[11px] font-bold uppercase tracking-[0.25em] text-primary-foreground">Sign in</a>
      <p class="mt-3 max-w-md text-sm text-muted-foreground">{{ s.how }}</p>
    {%- endif -%}
    <a href="/pages/stockists" class="mt-6 block underline underline-offset-4">Apply to become a stockist</a>
  </div>
</div>
{% schema %}
{
  "name": "Stockist sign in",
  "settings": [
    { "type": "text", "id": "note", "label": "Note", "default": "just for our partners." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "welcome back." },
    { "type": "textarea", "id": "text", "label": "Line", "default": "Already approved? Sign in below. New partners receive an account invitation after approval." },
    { "type": "text", "id": "how", "label": "Under the button", "default": "We'll email you a sign-in code. No password needed." }
  ]
}
{% endschema %}
