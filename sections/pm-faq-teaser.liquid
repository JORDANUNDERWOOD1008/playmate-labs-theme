<section class="mx-auto max-w-3xl px-5 pb-8 pt-16 md:px-6 md:pt-24">
  {% render 'pm-note', text: section.settings.note, class: '-rotate-2 text-xl' %}
  <h2 class="font-heavy mt-2 text-4xl font-black tracking-tight text-primary md:text-5xl">{{ section.settings.heading }}</h2>
  <div class="mt-6 divide-y divide-border border-y border-border">
    {%- for block in section.blocks -%}
      <details class="group py-4" {{ block.shopify_attributes }}>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-bold">{{ block.settings.q }}<span class="shrink-0 text-xl leading-none text-primary transition group-open:rotate-45">+</span></summary>
        <p class="mt-3 pr-8 font-light leading-relaxed text-muted-foreground">{{ block.settings.a }}</p>
      </details>
    {%- endfor -%}
  </div>
  <a href="{{ section.settings.link_url | default: '/pages/faq' }}" class="mt-6 inline-block border-b-2 border-primary pb-1 text-xs font-bold uppercase tracking-[0.25em] text-primary">{{ section.settings.link }}</a>
</section>
{% schema %}
{
  "name": "Questions teaser",
  "settings": [
    { "type": "text", "id": "note", "label": "Note", "default": "ask us anything." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "questions." },
    { "type": "text", "id": "link", "label": "Link text", "default": "See all FAQs" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "blocks": [{ "type": "qa", "name": "Question", "settings": [
    { "type": "text", "id": "q", "label": "Question" },
    { "type": "textarea", "id": "a", "label": "Answer" }
  ]}],
  "presets": [{ "name": "Questions teaser" }]
}
{% endschema %}
