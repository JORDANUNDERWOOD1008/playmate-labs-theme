{%- comment -%}
  Cart drawer. cinematic.js re-renders it through the Section Rendering API (?section_id=pm-cart-drawer)
  after every change, so all of the cart's numbers come from Shopify.
{%- endcomment -%}
{%- assign threshold = settings.pm_free_shipping | default: 4900 -%}
{%- assign left = threshold | minus: cart.total_price -%}
{%- assign pct = cart.total_price | times: 100 | divided_by: threshold -%}{%- if pct > 100 -%}{%- assign pct = 100 -%}{%- endif -%}
<div id="pm-cart" hidden class="fixed inset-0 z-50 flex justify-end" data-count="{{ cart.item_count }}">
  <button type="button" aria-label="Close cart" data-cart-close class="absolute inset-0 bg-foreground/40"></button>
  <aside class="relative flex h-full w-full max-w-md flex-col bg-background p-6" role="dialog" aria-modal="true" aria-label="Your cart">
    <div class="flex items-center justify-between">
      <h2 class="font-heavy text-2xl font-black text-primary">Your cart</h2>
      <button type="button" data-cart-close class="text-sm uppercase tracking-[0.2em]">Close</button>
    </div>
    {%- if cart.item_count == 0 -%}
      <div class="flex flex-1 flex-col items-center justify-center text-center">
        <p class="font-hand -rotate-2 text-xl text-primary">empty, for now.</p>
        <p class="mt-3 text-sm text-muted-foreground">Date-night games and chocolates made for two.</p>
        <a href="{{ routes.all_products_collection_url }}" class="mt-6 rounded-full bg-primary px-8 py-3 text-[11px] font-bold uppercase tracking-[0.25em] text-primary-foreground">Browse shop</a>
      </div>
    {%- else -%}
      <div class="mt-5 rounded-sm bg-card p-4 text-sm">
        {%- if left > 0 -%}You're <b>{{ left | money }}</b> away from free shipping.{%- else -%}You've unlocked <b>free shipping</b>.{%- endif -%}
        <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-muted">
          <div class="h-full bg-primary transition-all" style="width: {{ pct }}%"></div>
        </div>
      </div>
      <ul class="mt-6 flex-1 space-y-5 overflow-y-auto">
        {%- for item in cart.items -%}
          <li class="flex gap-4">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}" width="80" height="96" loading="lazy" class="h-24 w-20 rounded-sm object-cover">
            {%- else -%}<span class="h-24 w-20 rounded-sm bg-card"></span>{%- endif -%}
            <div class="flex-1">
              <a href="{{ item.url }}" class="font-heavy font-bold">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}<p class="text-xs text-muted-foreground">{{ item.variant.title }}</p>{%- endunless -%}
              {%- if item.selling_plan_allocation -%}<p class="text-xs text-muted-foreground">{{ item.selling_plan_allocation.selling_plan.name }}</p>{%- endif -%}
              <p class="text-sm text-primary">{{ item.final_line_price | money }}</p>
              <div class="mt-2 inline-flex items-center rounded-full border border-border">
                <button type="button" class="px-3 py-1" data-cart-line="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="One fewer">−</button>
                <span class="w-6 text-center text-sm">{{ item.quantity }}</span>
                <button type="button" class="px-3 py-1" data-cart-line="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="One more">+</button>
              </div>
            </div>
            <button type="button" class="self-start text-xs text-muted-foreground underline" data-cart-line="{{ item.key }}" data-qty="0">Remove</button>
          </li>
        {%- endfor -%}
      </ul>
      <div class="border-t border-border pt-5">
        <div class="flex justify-between font-heavy text-lg font-bold"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
        <a href="{{ routes.root_url }}checkout" class="mt-4 block w-full rounded-full bg-primary py-4 text-center text-[11px] font-bold uppercase tracking-[0.25em] text-primary-foreground">Checkout</a>
        <p class="mt-3 text-center text-[11px] uppercase tracking-[0.2em] text-muted-foreground">Secure checkout · 30-day returns</p>
      </div>
    {%- endif -%}
  </aside>
</div>
{% schema %}
{ "name": "Cart drawer", "settings": [] }
{% endschema %}
