{%- comment -%}
  Wholesale shop for approved stockists (/pages/wholesale). Shopify-native:
  - Visitors sign in with their Shopify customer account (new customer accounts, email code).
  - Access = the customer has the tag "stockist". Add it in Admin → Customers once approved.
  - Trade prices come from product metafields, never from theme files (the theme repo is public):
      custom.trade_unit_gbp / custom.trade_unit_eur  (per unit, in pence/cents, excl. VAT)
      custom.trade_units_per_case, custom.trade_cases_per_pallet
    Only products with custom.trade_unit_gbp set are listed, and prices are only rendered for
    tagged customers, so they never reach anyone else's browser.
  - "Send order request" goes to the store inbox via the contact form (tagged wholesale-order);
    the order is then invoiced as a draft order.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign login = routes.account_login_url | append: '?return_url=' | append: request.path | append: '&return_to=' | append: request.path -%}
<div class="mx-auto max-w-5xl px-5 py-10 md:py-16" data-wholesale>
  {% render 'pm-note', text: s.note, class: 'text-lg -rotate-2' %}
  {%- if customer == nil -%}
    <h1 class="font-heavy mt-4 text-4xl font-black leading-tight text-primary md:text-6xl">{{ s.out_title }}</h1>
    <div class="mt-8">
      <p class="max-w-xl text-muted-foreground">{{ s.out_text }}</p>
      <a href="/pages/stockist-login" class="mt-6 inline-flex min-h-12 items-center justify-center rounded-full bg-primary px-8 text-[11px] font-bold uppercase tracking-[0.25em] text-primary-foreground">Sign in</a>
      <a href="/pages/stockists" class="ml-4 mt-6 inline-block underline underline-offset-4">Apply to become a stockist</a>
    </div>
  {%- elsif customer.tags contains 'stockist' -%}
    <h1 class="font-heavy mt-4 text-4xl font-black leading-tight text-primary md:text-6xl">{{ s.in_title }}</h1>
    <div class="mt-8">
      {%- if s.video != blank -%}
        <div class="mb-10 overflow-hidden rounded-md bg-card">{{ s.video | video_tag: controls: true, playsinline: true, class: 'w-full', image_size: '1200x' }}</div>
      {%- endif -%}
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div><p class="font-bold">{{ customer.default_address.company | default: customer.name }}</p><p class="mt-1 text-sm text-muted-foreground">Per case · excluding VAT · shipping confirmed separately</p></div>
        <div class="flex gap-1" role="group" aria-label="Currency">
          <button type="button" data-currency="GBP" aria-pressed="true" class="min-h-11 rounded-md border border-primary bg-primary px-4 text-sm text-primary-foreground">£ GBP</button>
          <button type="button" data-currency="EUR" aria-pressed="false" class="min-h-11 rounded-md border border-border px-4 text-sm text-primary">€ EUR</button>
        </div>
      </div>
      {%- assign terms = s.terms | newline_to_br | split: '<br />' -%}
      {%- capture terms_html -%}{%- for t in terms -%}{%- assign kv = t | strip | split: '|' -%}{%- if kv[1] != blank -%}<div class="rounded-md bg-card p-4"><dt class="text-[11px] font-bold uppercase tracking-[0.2em] text-muted-foreground">{{ kv[0] | strip }}</dt><dd class="mt-1 text-sm">{{ kv[1] | strip }}</dd></div>{%- endif -%}{%- endfor -%}{%- endcapture -%}
      {%- if terms_html != blank -%}<dl class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-4">{{ terms_html }}</dl>{%- endif -%}
      {%- form 'contact', id: 'wholesale-order', data-wholesale-form: '' -%}
        {%- if form.posted_successfully? -%}
          <p class="font-hand mt-10 -rotate-2 text-2xl text-primary">{{ s.sent }}</p>
          <p class="mt-3 max-w-xl text-muted-foreground">{{ s.sent_text }}</p>
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="wholesale-order">
          <input type="hidden" name="contact[email]" value="{{ customer.email }}">
          <input type="hidden" name="contact[name]" value="{{ customer.name | escape }}">
          <input type="hidden" name="contact[Business]" value="{{ customer.default_address.company | escape }}">
          <input type="hidden" name="contact[Currency]" value="GBP" data-currency-field>
          <input type="hidden" name="contact[Order]" value="" data-order-field>
          <div class="mt-8 divide-y divide-border border-y border-border">
            {%- for p in collections.all.products -%}
              {%- assign m = p.metafields.custom -%}
              {%- if m.trade_unit_gbp != blank -%}
                {%- assign units = m.trade_units_per_case.value | default: 1 -%}
                {%- assign case_gbp = m.trade_unit_gbp.value | times: units -%}
                {%- assign case_eur = m.trade_unit_eur.value | default: 0 | times: units -%}
                <div class="grid grid-cols-[72px_minmax(0,1fr)] items-center gap-4 py-6 md:grid-cols-[100px_minmax(0,1fr)_140px_100px]" data-line data-handle="{{ p.handle }}" data-name="{{ p.title | escape }}" data-gbp="{{ case_gbp }}" data-eur="{{ case_eur }}">
                  {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 200 | image_tag: alt: p.title, class: 'aspect-square w-full rounded-md object-cover' }}{%- endif -%}
                  <div>
                    <h2 class="font-heavy text-lg font-bold text-primary md:text-2xl">{{ p.title }}</h2>
                    {%- assign rrp_ex = p.price | times: 100 | divided_by: 120 | round -%}
                    {%- assign unit_gbp = m.trade_unit_gbp.value | times: 1 -%}
                    <p class="mt-1 text-sm text-muted-foreground">{{ units }} per case{% if m.trade_cases_per_pallet != blank %}, {{ m.trade_cases_per_pallet.value }} cases per pallet{% endif %}{% unless p.available %}, out of stock{% endunless %}</p>
                    <p class="mt-1 text-sm">RRP {{ p.price | money }}{% if rrp_ex > 0 and unit_gbp > 0 %}{% assign margin = rrp_ex | minus: unit_gbp | times: 100 | divided_by: rrp_ex | round %}<span class="text-muted-foreground">, your margin about {{ margin }}% at RRP</span>{% endif %}</p>
                    <button type="button" data-dialog-open="ws-{{ p.handle }}" class="mt-2 text-sm font-medium text-primary underline underline-offset-4">Full details, compliance and assets</button>
                    {%- if m.trade_video != blank -%}<div class="mt-3 max-w-sm overflow-hidden rounded-md">{{ m.trade_video.value | video_tag: controls: true, playsinline: true, class: 'w-full', image_size: '600x' }}</div>{%- endif -%}
                  </div>
                  <p class="font-heavy text-2xl font-bold text-primary" data-case-price></p>
                  <label class="text-xs text-muted-foreground">Cases<input type="number" min="0" max="100000" step="1" value="0" inputmode="numeric" aria-label="Cases of {{ p.title | escape }}" {% unless p.available %}disabled{% endunless %} class="mt-1 min-h-11 w-full rounded-md border border-border bg-card px-3 text-base text-foreground"></label>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <label class="mt-6 block text-sm">Delivery address, timing, samples, documents or questions
            <textarea name="contact[body]" rows="4" data-ws-note class="mt-1 w-full rounded-md border border-border bg-card px-4 py-3 text-base"></textarea>
          </label>
          <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
            <div><p class="text-sm text-muted-foreground">Goods subtotal, excluding VAT</p><p class="font-heavy text-3xl font-black text-primary" data-total></p></div>
            <button data-submit disabled class="min-h-12 rounded-full bg-primary px-8 text-[11px] font-bold uppercase tracking-[0.25em] text-primary-foreground disabled:opacity-40">Send order request</button>
          </div>
          <p class="mt-4 text-sm text-muted-foreground">{{ s.order_note }}</p>
        {%- endif -%}
      {%- endform -%}
      {%- for p in collections.all.products -%}{%- assign m = p.metafields.custom -%}{%- if m.trade_unit_gbp != blank -%}
        {%- assign units = m.trade_units_per_case.value | default: 1 -%}
        {%- assign rrp_ex = p.price | times: 100 | divided_by: 120 | round -%}
        {%- assign unit_gbp = m.trade_unit_gbp.value | times: 1 -%}
        <dialog id="ws-{{ p.handle }}" aria-labelledby="ws-{{ p.handle }}-t" class="m-auto max-h-[90dvh] w-[min(56rem,calc(100vw-2rem))] overflow-y-auto rounded-md bg-background p-0 text-foreground backdrop:bg-foreground/50">
          <div class="sticky top-0 z-10 flex items-center justify-between gap-4 border-b border-border bg-background px-5 py-4 md:px-8">
            <h2 id="ws-{{ p.handle }}-t" class="font-heavy text-xl font-black text-primary md:text-2xl">{{ p.title }}</h2>
            <button type="button" data-dialog-close class="min-h-11 rounded-full border border-border px-4 text-sm">Close</button>
          </div>
          <div class="grid gap-10 px-5 py-6 md:px-8 md:py-8">
            <div class="grid gap-6 md:grid-cols-[14rem_minmax(0,1fr)]">
              {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 600 | image_tag: alt: p.title, class: 'aspect-square w-32 rounded-md object-cover md:w-full', loading: 'lazy' }}{%- endif -%}
              <div>
                <h3 class="text-[11px] font-bold uppercase tracking-[0.25em] text-muted-foreground">Commercials</h3>
                <dl class="mt-3 grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
                  <div class="rounded-md bg-card p-3"><dt class="text-muted-foreground">Case price</dt><dd class="font-heavy text-lg font-bold text-primary" data-ws-case="{{ p.handle }}"></dd></div>
                  <div class="rounded-md bg-card p-3"><dt class="text-muted-foreground">Unit price</dt><dd class="font-heavy text-lg font-bold text-primary">{{ unit_gbp | money }}</dd></div>
                  <div class="rounded-md bg-card p-3"><dt class="text-muted-foreground">RRP (inc. VAT)</dt><dd class="font-heavy text-lg font-bold text-primary">{{ p.price | money }}</dd></div>
                  {%- if rrp_ex > 0 and unit_gbp > 0 -%}{%- assign margin = rrp_ex | minus: unit_gbp | times: 100 | divided_by: rrp_ex | round -%}
                  <div class="rounded-md bg-card p-3"><dt class="text-muted-foreground">Margin at RRP</dt><dd class="font-heavy text-lg font-bold text-primary">{{ margin }}%</dd></div>{%- endif -%}
                  <div class="rounded-md bg-card p-3"><dt class="text-muted-foreground">Units per case</dt><dd class="font-heavy text-lg font-bold text-primary">{{ units }}</dd></div>
                  {%- if m.trade_cases_per_pallet != blank -%}<div class="rounded-md bg-card p-3"><dt class="text-muted-foreground">Cases per pallet</dt><dd class="font-heavy text-lg font-bold text-primary">{{ m.trade_cases_per_pallet.value }}</dd></div>{%- endif -%}
                </dl>
                <p class="mt-3 text-xs text-muted-foreground">Prices exclude VAT. Margin is worked out on the RRP without VAT (20%). Stock: {% if p.available %}available{% else %}out of stock, ask us for the next date{% endif %}.</p>
              </div>
            </div>
            <section>
              <h3 class="font-heavy text-2xl font-black tracking-tight text-primary">product facts.</h3>
              <div class="mt-4">{% render 'pm-trade-info', product: p, part: 'facts' %}</div>
              <dl class="mt-3 grid gap-x-6 gap-y-3 text-sm sm:grid-cols-[10rem_minmax(0,1fr)]">
                {%- for v in p.variants -%}{%- if v.barcode != blank -%}<dt class="font-medium text-primary">Barcode{% if p.variants.size > 1 %} ({{ v.title }}){% endif %}</dt><dd class="font-light tabular-nums">{{ v.barcode }}</dd>{%- endif -%}{%- endfor -%}
                {%- assign v0 = p.selected_or_first_available_variant -%}{%- if v0.weight > 0 -%}<dt class="font-medium text-primary">Unit weight, packed</dt><dd class="font-light">{{ v0.weight | divided_by: 1000.0 }} kg</dd>{%- endif -%}
                <dt class="font-medium text-primary">Case and pallet size</dt><dd class="font-light">{{ m.trade_case_dims.value | default: s.dims_fallback }}</dd>
              </dl>
              {%- if m.ingredients != blank -%}
                <div class="mt-6 rounded-md bg-card p-5"><h4 class="font-medium text-primary">Ingredients and allergens</h4><div class="pm-rte mt-2 text-sm font-light">{{ m.ingredients | metafield_tag }}</div></div>
              {%- endif -%}
            </section>
            <section>
              <h3 class="font-heavy text-2xl font-black tracking-tight text-primary">compliance.</h3>
              <p class="mt-2 max-w-2xl text-sm font-light text-muted-foreground">{{ s.compliance_line }}</p>
              <div class="mt-4">{% render 'pm-trade-info', product: p, part: 'compliance' %}</div>
              <h4 class="mt-6 font-medium text-primary">Documents</h4>
              <p class="mt-1 text-sm font-light text-muted-foreground">Ask for any of these and we'll email them the same working day.</p>
              <div class="mt-3">{% render 'pm-trade-info', product: p, part: 'docs' %}</div>
            </section>
            <section>
              <h3 class="font-heavy text-2xl font-black tracking-tight text-primary">sell it.</h3>
              <div class="mt-4 grid gap-4 md:grid-cols-2">
                <div class="rounded-md bg-card p-5">
                  <div class="flex items-center justify-between gap-4"><h4 class="font-medium text-primary">Copy for your shop or listing</h4>
                    {%- capture listing -%}{% render 'pm-trade-info', product: p, part: 'copy' %}{%- endcapture -%}
                    <button type="button" data-copy="{{ listing | strip | escape }}" class="rounded-full border border-border px-3 py-1 text-xs"><span data-copy-label>Copy</span></button></div>
                  <p class="mt-2 text-sm font-light">{{ listing | strip }}</p>
                </div>
                <div class="rounded-md bg-card p-5">
                  <h4 class="font-medium text-primary">Images and video</h4>
                  <ul class="mt-2 space-y-2 text-sm">
                    {%- if s.assets_url != blank -%}<li><a href="{{ s.assets_url }}" class="underline underline-offset-4">Product images (ZIP)</a></li>{%- endif -%}
                    <li><a href="/pages/press" class="underline underline-offset-4">Press page: facts and full-size images</a></li>
                    {%- if s.video != blank -%}<li>Stockist video: at the top of this page</li>{%- endif -%}
                    <li><button type="button" data-ws-request="Please send: shelf and display images for {{ p.title | escape }}" class="underline underline-offset-4">Ask for shelf or display images</button></li>
                  </ul>
                </div>
              </div>
            </section>
            <div class="flex flex-wrap items-center gap-3 border-t border-border pt-6">
              <button type="button" data-ws-request="Sample request: {{ p.title | escape }}" class="inline-flex min-h-12 items-center rounded-full bg-primary px-6 text-sm font-medium text-primary-foreground">Request a sample</button>
              <button type="button" data-dialog-close class="min-h-12 rounded-full border border-border px-6 text-sm">Back to the order</button>
            </div>
          </div>
        </dialog>
      {%- endif -%}{%- endfor -%}
    </div>
  {%- else -%}
    <h1 class="font-heavy mt-4 text-4xl font-black leading-tight text-primary md:text-6xl">{{ s.wait_title }}</h1>
    <div class="mt-8"><p class="max-w-xl text-muted-foreground">{{ s.wait_text }}</p></div>
  {%- endif -%}
  <div class="mt-10 flex flex-wrap items-center gap-4 text-sm">
    {%- if customer -%}<a href="{{ routes.account_url }}" class="underline underline-offset-4">Your account</a><a href="{{ routes.account_logout_url }}" class="text-muted-foreground underline underline-offset-4">Sign out</a>{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Wholesale shop",
  "settings": [
    { "type": "text", "id": "note", "label": "Note", "default": "just for our partners." },
    { "type": "text", "id": "out_title", "label": "Signed out: heading", "default": "partners only." },
    { "type": "textarea", "id": "out_text", "label": "Signed out: line", "default": "Already approved? Sign in below. New partners receive an account invitation after approval." },
    { "type": "text", "id": "wait_title", "label": "Not approved yet: heading", "default": "not quite yet." },
    { "type": "textarea", "id": "wait_text", "label": "Not approved yet: line", "default": "Wholesale access is awaiting approval." },
    { "type": "text", "id": "in_title", "label": "Approved: heading", "default": "stock up." },
    { "type": "video", "id": "video", "label": "Stockist video (shown to approved stockists only)" },
    { "type": "textarea", "id": "terms", "label": "Trade terms, one per line as Label|Value (blank value = hidden)", "default": "Minimum order|\nDelivery|\nLead time|\nPayment|Invoice after we confirm stock, VAT and shipping" },
    { "type": "textarea", "id": "compliance_line", "label": "Compliance intro", "default": "What we have on file for this product. Everything below is available to approved stockists." },
    { "type": "text", "id": "dims_fallback", "label": "Case and pallet size, when not set on the product", "default": "Confirmed with your quote" },
    { "type": "url", "id": "assets_url", "label": "Product images ZIP for stockists" },
    { "type": "textarea", "id": "order_note", "label": "Under the order button", "default": "We confirm stock, VAT and shipping, then send an invoice. Online wholesale payment is not connected yet." },
    { "type": "text", "id": "sent", "label": "After sending", "default": "order request sent." },
    { "type": "textarea", "id": "sent_text", "label": "After sending, line", "default": "We'll confirm stock, VAT and shipping and send your invoice within two working days." }
  ]
}
{% endschema %}
