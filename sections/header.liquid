{%- if section.settings.section_hidden == false -%}
{% comment %}
  PLAYMATE LABS — HEADER SECTION
  File: sections/header.liquid
{% endcomment %}

{%- comment -%}
  global.css is already loaded by the layout, before theme-css-variables.
  Loading it again here re-declared :root and reverted every variable the
  settings had just set — which is why choosing a heading font left the
  hero headline rendering in the stylesheet's hardcoded display face.
{%- endcomment -%}

{%- comment -%}
  Logo sizing. The <img> carried an inline height:40px, and an inline style
  beats every stylesheet rule — which is why the size controls did nothing.
  The inline rule now reads a variable instead, so the settings can drive it.
{%- endcomment -%}
{%- liquid
  assign logo_h = section.settings.logo_height
  assign logo_h_m = section.settings.logo_height_mobile
  if settings.header_is_pills
    assign logo_h = section.settings.pill_logo_height
    assign logo_h_m = section.settings.pill_logo_height_mobile
  endif
-%}
{%- style -%}
  #shopify-section-{{ section.id }} .nav-logo-img {
    --nav-logo-h: {{ logo_h }}px;
    {%- if section.settings.logo_max_width > 0 %}
    --nav-logo-max: {{ section.settings.logo_max_width }}px;
    {%- endif %}
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .nav-logo-img { --nav-logo-h: {{ logo_h_m }}px; }
  }
  {%- comment -%} Label mode: words instead of icons in the right capsule {%- endcomment -%}
  {%- if section.settings.pill_show_labels %}
  #shopify-section-{{ section.id }} .nav-pills .nav-btn-label {
    display: inline;
    font-family: var(--font-sans);
    font-size: {{ section.settings.pill_label_size }}px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .nav-pills .nav-actions .nav-icon-btn svg { display: none; }
  #shopify-section-{{ section.id }} .nav-pills [data-cart-open] svg { display: none; }
  #shopify-section-{{ section.id }} .nav-pills .nav-actions .nav-icon-btn { width: auto; }
  {%- unless section.settings.pill_show_search %}
  #shopify-section-{{ section.id }} .nav-pills .nav-search-btn { display: none; }
  {%- endunless %}
  @media (max-width: 768px) {
    {%- unless section.settings.pill_labels_mobile %}
    #shopify-section-{{ section.id }} .nav-pills .nav-btn-label { display: none; }
    #shopify-section-{{ section.id }} .nav-pills .nav-actions .nav-icon-btn svg,
    #shopify-section-{{ section.id }} .nav-pills [data-cart-open] svg { display: block; }
    {%- endunless %}
  }
  {%- endif %}
{%- endstyle -%}

{%- comment -%}
  Floating-pill header. The bar goes transparent and the logo and the action
  group each become their own rounded capsule sitting over whatever is behind
  them. CSS only — no change to the markup order — so switching it off returns
  the original solid bar exactly.
{%- endcomment -%}
{%- if settings.header_is_pills -%}
{%- style -%}
  #shopify-section-{{ section.id }} .site-nav.nav-pills,
  #shopify-section-{{ section.id }} .site-nav.nav-pills.scrolled,
  #shopify-section-{{ section.id }} .site-nav.nav-pills.nav-dark {
    background: transparent;
    backdrop-filter: none;
    box-shadow: none;
  }
  {%- if section.settings.pill_overlay -%}
  {%- comment -%}
    The header section still sits in the document flow, so even with a fixed
    nav inside it there is a band of page above the hero — the white strip.
    Taking it out of flow lets the hero start at the very top and the pills
    float over the photograph, which is the whole point of this style.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} {
    position: absolute !important;
    top: 0; left: 0; right: 0;
    height: 0 !important;
    overflow: visible;
  }
  {%- endif -%}
  #shopify-section-{{ section.id }} .nav-pills .nav-inner {
    gap: {{ section.settings.pill_gap }}px;
    align-items: center;
  }
  {%- comment -%} The logo needs its own size here — it is no longer sharing a
      bar with the nav links, so the bar height stops constraining it. {%- endcomment -%}
  #shopify-section-{{ section.id }} .nav-pills .nav-logo span {
    font-size: {{ section.settings.pill_logo_height | times: 0.7 | round }}px;
  }
  {%- comment -%}
    Both capsules take the same explicit height. Sizing them by padding alone
    let them drift apart, because the icons in the right-hand pill are taller
    than the logo in the left one.
  {%- endcomment -%}
  {%- comment -%}
    Two capsules: logo + hamburger on the left, actions on the right, both the
    same height so they cannot drift apart.
  {%- endcomment -%}
  {%- comment -%} Shared capsule shape; the two differ only in height and padding {%- endcomment -%}
  #shopify-section-{{ section.id }} .nav-pills .nav-lockup,
  #shopify-section-{{ section.id }} .nav-pills .nav-actions {
    display: flex;
    align-items: center;
    gap: {{ section.settings.pill_inner_gap }}px;
    box-sizing: border-box;
    background: {{ section.settings.pill_bg }};
    border-radius: 999px;
    box-shadow: 0 2px 16px rgba(0,0,0,{{ section.settings.pill_shadow | divided_by: 100.0 }});
  }
  #shopify-section-{{ section.id }} .nav-pills .nav-lockup {
    height: {{ section.settings.pill_height }}px;
    padding: 0 {{ section.settings.pill_pad_x }}px;
  }
  {%- comment -%}
    The right capsule is deliberately shorter than the left, and in label mode
    its right padding shrinks so the cart capsule finishes flush with the end
    of the pill rather than floating inside it.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .nav-pills .nav-actions {
    height: {{ section.settings.pill_height_actions | default: section.settings.pill_height }}px;
    {%- if section.settings.pill_show_labels %}
    padding: 0 {{ section.settings.pill_cart_inset }}px 0 {{ section.settings.pill_pad_x | plus: 6 }}px;
    {%- else %}
    padding: 0 {{ section.settings.pill_pad_x }}px;
    {%- endif %}
  }
  #shopify-section-{{ section.id }} .nav-pills .nav-logo {
    display: flex;
    align-items: center;
    background: none;
    padding: 0;
    box-shadow: none;
    height: auto;
  }
  {%- comment -%} The hamburger belongs in the left capsule at every width {%- endcomment -%}
  #shopify-section-{{ section.id }} .nav-pills .nav-toggle {
    display: flex !important;
    position: static;
    width: 20px;
  }
  {%- comment -%} Cart as its own accent capsule nested in the right one {%- endcomment -%}
  {%- if section.settings.pill_cart_accent -%}
  #shopify-section-{{ section.id }} .nav-pills .nav-actions .nav-icon-btn[data-cart-open],
  #shopify-section-{{ section.id }} .nav-pills [data-cart-open] {
    background: {{ section.settings.pill_cart_bg }};
    color: {{ section.settings.pill_cart_text }};
    border-radius: 999px;
    {%- assign ah = section.settings.pill_height_actions | default: section.settings.pill_height -%}
    height: {{ ah | minus: section.settings.pill_cart_inset | minus: section.settings.pill_cart_inset }}px;
    padding: 0 {% if section.settings.pill_show_labels %}18{% else %}14{% endif %}px;
    display: flex;
    align-items: center;
    gap: 7px;
  }
  {%- endif -%}
  {%- comment -%} Icons must not push the capsule taller than its set height {%- endcomment -%}
  #shopify-section-{{ section.id }} .nav-pills .nav-icon-btn,
  #shopify-section-{{ section.id }} .nav-pills .nav-toggle {
    height: auto;
    padding: 0 6px;
  }
  {%- comment -%}
    Only things inside a capsule take the capsule's text colour. The inline
    menu links sit outside them, on the page itself — colouring them white made
    them vanish against a light hero, which reads as the menu overlapping the
    pills.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .nav-pills .nav-lockup .nav-logo span,
  #shopify-section-{{ section.id }} .nav-pills .nav-actions .nav-link,
  #shopify-section-{{ section.id }} .nav-pills .nav-actions .nav-icon-btn {
    color: {{ section.settings.pill_icon_color }};
  }
  {%- if section.settings.pill_hide_menu -%}
  {%- comment -%} Hamburger at every width, as the reference does {%- endcomment -%}
  #shopify-section-{{ section.id }} .nav-pills .nav-links { display: none; }
  {%- else -%}
  #shopify-section-{{ section.id }} .nav-pills .nav-links .nav-link {
    color: {{ section.settings.pill_link_color }};
  }
  {%- endif -%}
  #shopify-section-{{ section.id }} .nav-pills .nav-toggle span {
    background: {{ section.settings.pill_text }};
  }
  {%- comment -%} The cart sits inside the right pill as its own accent capsule {%- endcomment -%}
  {%- comment -%} CTA and cart are separate accents, not one shared colour {%- endcomment -%}
  #shopify-section-{{ section.id }} .nav-pills .nav-cta {
    background: {{ section.settings.pill_cta_bg }};
    color: {{ section.settings.pill_cta_text }};
    border-radius: 999px;
  }
  {%- if section.settings.pill_hide_search_mobile %}
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .nav-pills #search-toggle { display: none; }
  }
  {%- endif %}
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .nav-pills .nav-inner {
      padding-left: {{ section.settings.pill_edge_mobile }}px;
      padding-right: {{ section.settings.pill_edge_mobile }}px;
    }
    #shopify-section-{{ section.id }} .nav-pills .nav-lockup,
    #shopify-section-{{ section.id }} .nav-pills .nav-actions {
      height: {{ section.settings.pill_height_mobile }}px;
      padding: 0 {{ section.settings.pill_pad_x_mobile }}px;
    }
    {%- if section.settings.pill_cart_accent %}
    #shopify-section-{{ section.id }} .nav-pills .nav-actions .nav-icon-btn[data-cart-open],
  #shopify-section-{{ section.id }} .nav-pills [data-cart-open] {
      height: {{ section.settings.pill_height_mobile | minus: 12 }}px;
      padding: 0 11px;
    }
    {%- endif %}
    #shopify-section-{{ section.id }} .nav-pills .nav-logo span {
      font-size: {{ section.settings.pill_logo_height_mobile | times: 0.7 | round }}px;
    }
  }
{%- endstyle -%}
{%- endif -%}

<nav class="site-nav{% if section.settings.dark_style %} nav-dark{% endif %}{% if settings.header_is_pills %} nav-pills{% endif %}" id="main-nav" role="navigation" aria-label="Main navigation">
  <div class="nav-inner">

    {%- comment -%} Logo {%- endcomment -%}
    {%- comment -%}
      Logo and hamburger share one capsule in pill mode. The wrapper is
      display:contents in the solid-bar style, so it changes nothing there.
    {%- endcomment -%}
    <div class="nav-lockup">
    <a href="{{ routes.root_url }}" class="nav-logo" aria-label="{{ shop.name }} Home">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: height: 160 }}"
             alt="{{ shop.name }}"
             loading="eager"
             class="nav-logo-img"
             style="width:auto;height:var(--nav-logo-h,40px);max-width:var(--nav-logo-max,none);object-fit:contain;">
      {%- else -%}
        <img src="{{ 'playmate-logo.png' | asset_url }}"
             alt="{{ shop.name }}"
             loading="eager"
             class="nav-logo-img"
             style="width:auto;height:var(--nav-logo-h,40px);max-width:var(--nav-logo-max,none);object-fit:contain;">
      {%- endif -%}
    </a>
      <button class="nav-toggle" aria-label="Toggle mobile menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>

    {%- comment -%} Desktop Navigation {%- endcomment -%}
    <ul class="nav-links" role="list">
      {%- for link in linklists[section.settings.menu].links -%}
        {%- if link.links != blank -%}
          <li class="nav-item nav-item--has-dropdown">
            <button class="nav-link nav-dropdown-toggle" aria-expanded="false" aria-haspopup="true">
              {{ link.title }}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-left:0.25rem;">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </button>
            <ul class="nav-dropdown" role="list">
              {%- for childlink in link.links -%}
                <li><a href="{{ childlink.url }}" class="nav-dropdown-link"{% if childlink.current %} aria-current="page"{% endif %}>{{ childlink.title }}</a></li>
              {%- endfor -%}
            </ul>
          </li>
        {%- else -%}
          <li class="nav-item">
            <a href="{{ link.url }}"
               class="nav-link"
               {% if link.current %}aria-current="page"{% endif %}>
              {{ link.title }}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- comment -%} Nav Actions {%- endcomment -%}
    <div class="nav-actions">
      {%- if section.settings.show_experience_cta -%}
        <a href="{{ section.settings.cta_url | default: '#newsletter' }}"
           class="nav-cta"
           data-show-on-scroll>
          {{ section.settings.cta_text | default: 'Join the list' }}
        </a>
      {%- endif -%}

      {%- comment -%} Search {%- endcomment -%}
      <button class="nav-icon-btn nav-search-btn" id="search-toggle" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      {%- comment -%} Cart {%- endcomment -%}
      <button class="nav-icon-btn" data-cart-open aria-label="Open cart ({{ cart.item_count }} items)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        <span class="nav-btn-label">{{ section.settings.pill_cart_label | default: 'Cart' }}</span>
        <span class="cart-count" {% if cart.item_count == 0 %}style="display:none;"{% endif %}>
          {{ cart.item_count }}
        </span>
      </button>

      {%- comment -%} Account {%- endcomment -%}
      {%- if customer -%}
        <a href="{{ routes.account_url }}" class="nav-icon-btn" aria-label="My Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <span class="nav-btn-label">{{ section.settings.pill_account_label | default: 'My account' }}</span>
        </a>
      {%- else -%}
        <a href="{{ routes.account_login_url }}" class="nav-icon-btn" aria-label="Sign In">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <span class="nav-btn-label">{{ section.settings.pill_account_label | default: 'My account' }}</span>
        </a>
      {%- endif -%}

      {%- comment -%} Mobile Hamburger {%- endcomment -%}

    </div>
  </div>
</nav>

{%- comment -%} Mobile Overlay {%- endcomment -%}
<div class="mobile-menu-overlay" id="mobile-overlay"></div>

{%- comment -%}
  Mobile Menu

  Products first, as rows with their own photography, then the pages. A menu
  that lists only page names asks someone to guess what is behind them; at
  this catalogue size the products can simply be the menu.
{%- endcomment -%}
<nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation">
  <div class="mobile-menu-scroll">

    {%- assign menu_collection = collections[section.settings.menu_collection] -%}
    {%- if menu_collection != blank and menu_collection.products.size > 0 -%}
      <p class="mobile-menu-heading">{{ section.settings.menu_shop_label | default: 'Shop' }}</p>
      <ul class="mobile-product-list">
        {%- for product in menu_collection.products limit: section.settings.menu_product_limit -%}
          {%- assign m_img = product.metafields.custom.card_image.value | default: product.featured_image -%}
          <li>
            <a href="{{ product.url }}" class="mobile-product-row">
              <span class="mobile-product-thumb">
                {%- if m_img -%}
                  <img src="{{ m_img | image_url: width: 160 }}" width="160" height="160"
                       alt="" loading="lazy" decoding="async">
                {%- endif -%}
              </span>
              <span class="mobile-product-name">{{ product.title }}</span>
              {%- unless product.available -%}
                <span class="mobile-product-flag">Sold out</span>
              {%- endunless -%}
              <svg class="mobile-product-chev" width="16" height="16" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <ul class="mobile-nav-links">
      {%- for link in linklists[section.settings.mobile_menu].links -%}
        <li>
          <a href="{{ link.url }}" class="mobile-nav-link"
             {% if link.current %}aria-current="page"{% endif %}>
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
      {%- if section.settings.stockist_text != blank -%}
        <li>
          <a href="{{ section.settings.stockist_url | default: '/pages/contact' }}" class="mobile-nav-link">
            {{ section.settings.stockist_text }}
          </a>
        </li>
      {%- endif -%}
    </ul>

    {%- if settings.social_instagram_link != blank or settings.social_tiktok_link != blank -%}
    <div class="mobile-menu-social">
      {%- if settings.social_instagram_link != blank -%}
        <a href="{{ settings.social_instagram_link }}" class="footer-social-link" aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
      {%- endif -%}
      {%- if settings.social_tiktok_link != blank -%}
        <a href="{{ settings.social_tiktok_link }}" class="footer-social-link" aria-label="TikTok" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.83a8.24 8.24 0 004.82 1.55V6.93a4.85 4.85 0 01-1.05-.24z"/></svg>
        </a>
      {%- endif -%}
    </div>
    {%- endif -%}
  </div>

  {%- comment -%} Pinned so the cart is reachable without scrolling back. {%- endcomment -%}
  <div class="mobile-menu-footer">
    <a href="{{ routes.cart_url }}" class="btn btn-primary mobile-menu-cart">
      {{ section.settings.menu_cart_label | default: 'Cart' }}
      <span class="mobile-menu-cart-count" data-cart-count>{{ cart.item_count }}</span>
    </a>
  </div>
</nav>

{%- comment -%} Search Bar (slide-down) {%- endcomment -%}
<div class="search-bar" id="search-bar" aria-hidden="true">
  <div class="container">
    <form action="/search" method="get">
      <input type="search" name="q" placeholder="Search products, drops, rituals…" class="search-input" aria-label="Search">
      <button type="submit" class="btn btn-primary btn-sm">Search</button>
      <button type="button" id="search-close" class="nav-icon-btn" aria-label="Close search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </form>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "class": "playmate-header-section",
  "settings": [
    {
      "type": "header",
      "content": "⚙️ Section Visibility"
    },
    {
      "type": "checkbox",
      "id": "section_hidden",
      "label": "Hide this section",
      "default": false,
      "info": "Tick to hide this section from the live site. Untick to show it again."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 14,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo height — desktop",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Logo height — mobile",
      "default": 32
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 0,
      "max": 400,
      "step": 10,
      "default": 0,
      "unit": "px",
      "label": "Logo max width (0 = no limit)",
      "info": "Optional cap for a very wide wordmark. Height below is the main control."
    },
    {
      "type": "checkbox",
      "id": "dark_style",
      "label": "Dark navigation style",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Desktop navigation menu"
    },
    {
      "type": "link_list",
      "id": "mobile_menu",
      "default": "main-menu",
      "label": "Mobile navigation menu"
    },
    {
      "type": "checkbox",
      "id": "show_experience_cta",
      "label": "Show the header button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Header button text",
      "default": "Join the list"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Header button link",
      "info": "Leave blank to jump to the sign-up section on the page."
    },
    {
      "type": "text",
      "id": "cta2_text",
      "label": "Mobile menu — second button",
      "default": "Shop the range"
    },
    {
      "type": "header",
      "content": "🔗 Button URLs (editable in customiser)"
    },
    {
      "type": "url",
      "id": "url_experience",
      "label": "Experience Page (Nav CTA)"
    },
    {
      "type": "url",
      "id": "url_monthly_drops",
      "label": "Monthly Drops (Mobile Menu)"
    },
    {
      "type": "header",
      "content": "🧭 Floating-pill style"
    },
    {
      "type": "paragraph",
