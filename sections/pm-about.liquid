{%- comment -%} About page from the cinematic site. Lists are blocks: belief, photo, making. {%- endcomment -%}
{%- assign s = section.settings -%}
<div class="mx-auto max-w-6xl px-5 pb-24 md:px-6">
  <section class="py-12 text-center md:py-16">
    {% render 'pm-note', text: s.note, class: '-rotate-2 text-xl' %}
    <h1 class="font-heavy mx-auto mt-4 max-w-3xl text-4xl font-black leading-[0.95] tracking-tight text-primary sm:text-5xl md:text-7xl">{{ s.heading }}</h1>
    <p class="mx-auto mt-6 max-w-xl text-lg font-light leading-relaxed text-muted-foreground">{{ s.intro }}</p>
  </section>
  <div class="relative">
    {%- if s.image != blank -%}{{ s.image | image_url: width: 1600 | image_tag: alt: s.image_alt, widths: '600, 1000, 1600', class: 'aspect-[4/3] w-full rounded-sm object-cover md:aspect-[16/9]' }}
    {%- else -%}<img width="1100" height="821" src="{{ 'pm-hands.webp' | asset_url }}" alt="{{ s.image_alt | escape }}" class="aspect-[4/3] w-full rounded-sm object-cover md:aspect-[16/9]">{%- endif -%}
    {% render 'pm-note', text: s.image_note, light: true, class: 'absolute bottom-6 right-6 -rotate-6 text-2xl drop-shadow md:bottom-8 md:right-10 md:text-4xl' %}
  </div>
  <section class="mx-auto max-w-2xl pt-16 md:pt-24">
    <p class="text-[11px] uppercase tracking-[0.3em] text-muted-foreground">{{ s.story_label }}</p>
    <h2 class="font-heavy mt-3 text-3xl font-black tracking-tight text-primary md:text-5xl">{{ s.story_heading }}</h2>
    <div class="mt-6 space-y-5 text-lg font-light leading-relaxed">{{ s.story }}</div>
    {% render 'pm-note', text: s.story_note, class: 'mt-6 -rotate-1 text-xl' %}
  </section>
  <section class="pt-16 md:pt-24">
    <h2 class="font-heavy text-center text-3xl font-black tracking-tight text-primary md:text-5xl">{{ s.beliefs_heading }}</h2>
    <div class="mt-10 grid gap-4 md:grid-cols-3 md:gap-5">
      {%- for b in section.blocks -%}{%- if b.type == 'belief' -%}
        <article class="rounded-md bg-card p-6 md:p-8" {{ b.shopify_attributes }}>
          {% render 'pm-note', text: b.settings.note, class: '-rotate-2 text-base' %}
          <h3 class="font-heavy mt-3 text-xl font-bold leading-tight text-primary">{{ b.settings.title }}</h3>
          <p class="mt-3 font-light leading-relaxed text-muted-foreground">{{ b.settings.body }}</p>
        </article>
      {%- endif -%}{%- endfor -%}
    </div>
  </section>
  <section class="grid grid-cols-3 gap-2 pt-16 md:gap-6 md:pt-24">
    {%- for b in section.blocks -%}{%- if b.type == 'photo' -%}
      {%- capture tilt -%}{%- cycle 'tilt2': '-rotate-2', 'rotate-1', '-rotate-1' -%}{%- endcapture -%}
      <div {{ b.shopify_attributes }}>
        {%- if b.settings.image != blank -%}{{ b.settings.image | image_url: width: 800 | image_tag: alt: b.settings.alt, loading: 'lazy', class: 'aspect-[4/5] w-full rounded-sm object-cover' }}
        {%- else -%}<img width="1100" height="1375" src="{{ b.settings.asset | asset_url }}" alt="{{ b.settings.alt | escape }}" loading="lazy" class="aspect-[4/5] w-full rounded-sm object-cover">{%- endif -%}
        {%- assign note_class = 'mt-2 text-sm md:text-lg ' | append: tilt -%}
        {% render 'pm-note', text: b.settings.note, class: note_class %}
      </div>
    {%- endif -%}{%- endfor -%}
  </section>
  <section class="mx-auto max-w-3xl pt-16 md:pt-24">
    <p class="text-[11px] uppercase tracking-[0.3em] text-muted-foreground">{{ s.making_label }}</p>
    <h2 class="font-heavy mt-3 text-3xl font-black tracking-tight text-primary md:text-5xl">{{ s.making_heading }}</h2>
    <ul class="mt-6 divide-y divide-border border-y border-border">
      {%- for b in section.blocks -%}{%- if b.type == 'making' -%}
        <li class="flex flex-col gap-1 py-5 md:flex-row md:items-baseline md:justify-between md:gap-8" {{ b.shopify_attributes }}>
          <span class="font-heavy shrink-0 text-xl font-bold text-primary">{{ b.settings.name }}</span>
          <span class="font-light text-muted-foreground md:max-w-md md:text-right">{{ b.settings.line }}</span>
        </li>
      {%- endif -%}{%- endfor -%}
    </ul>
    <p class="mt-6 text-sm font-light text-muted-foreground">{{ s.making_small }}</p>
  </section>
  <section class="pt-16 text-center md:pt-24">
    <p class="mx-auto max-w-xl text-lg font-light">{{ s.outro }}</p>
    {% render 'pm-note', text: s.signoff, class: 'mt-4 -rotate-2 text-2xl' %}
    <div class="mt-8 flex flex-wrap items-center justify-center gap-6">
      <a href="{{ routes.all_products_collection_url }}" class="rounded-full bg-primary px-10 py-4 text-xs font-bold uppercase tracking-[0.25em] text-primary-foreground">Shop all</a>
      <a href="/pages/stockists" class="border-b-2 border-primary pb-1 text-xs font-bold uppercase tracking-[0.25em] text-primary">Become a stockist</a>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "About (cinematic)",
  "settings": [
    { "type": "text", "id": "note", "label": "Note", "default": "hello, you." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "we don't sell sex. we invite intimacy." },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "image_picker", "id": "image", "label": "Big photo" },
    { "type": "text", "id": "image_alt", "label": "Big photo description", "default": "Two people playing a stacking game together" },
    { "type": "text", "id": "image_note", "label": "Note on the photo", "default": "your move." },
    { "type": "text", "id": "story_label", "label": "Story label", "default": "Our story" },
    { "type": "text", "id": "story_heading", "label": "Story heading", "default": "it started with a question." },
    { "type": "richtext", "id": "story", "label": "Story" },
    { "type": "text", "id": "story_note", "label": "Story note", "default": "(that's the whole idea.)" },
    { "type": "text", "id": "beliefs_heading", "label": "Beliefs heading", "default": "what we believe." },
    { "type": "text", "id": "making_label", "label": "Making label", "default": "Inside the lab" },
    { "type": "text", "id": "making_heading", "label": "Making heading", "default": "what we make." },
    { "type": "textarea", "id": "making_small", "label": "Making small print" },
    { "type": "textarea", "id": "outro", "label": "Closing line" },
    { "type": "text", "id": "signoff", "label": "Sign-off", "default": "with love, the lab x" }
  ],
  "blocks": [
    { "type": "belief", "name": "Belief", "settings": [{ "type": "text", "id": "note", "label": "Note" }, { "type": "text", "id": "title", "label": "Title" }, { "type": "textarea", "id": "body", "label": "Text" }] },
    { "type": "photo", "name": "Photo", "settings": [{ "type": "image_picker", "id": "image", "label": "Photo" }, { "type": "text", "id": "asset", "label": "Theme asset (used when no photo is picked)" }, { "type": "text", "id": "alt", "label": "Description" }, { "type": "text", "id": "note", "label": "Note" }] },
    { "type": "making", "name": "Product line", "settings": [{ "type": "text", "id": "name", "label": "Name" }, { "type": "text", "id": "line", "label": "Line" }] }
  ]
}
{% endschema %}
