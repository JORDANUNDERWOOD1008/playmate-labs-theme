{%- comment -%}
  Press & media kit (/pages/press, template page.press). Everything is editable in the theme editor:
  boilerplate, product fact sheets, images (from Files), coverage, free tools, founder and contact.
  Images link to their full-size file; the ZIP is a Files URL in the section settings.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign mail = 'mailto:' | append: s.email | append: '?subject=' -%}
<div class="mx-auto max-w-6xl px-5 pb-24 pt-6 md:px-6 md:pt-12">
  <p class="text-[11px] uppercase tracking-[0.25em] text-muted-foreground"><a href="{{ routes.root_url }}">Home</a> › Press</p>
  {% render 'pm-note', text: s.note, class: 'mt-8 -rotate-2 text-xl' %}
  <h1 class="font-heavy mt-2 text-4xl font-black leading-none tracking-tight text-primary sm:text-5xl md:text-7xl">{{ s.heading }}</h1>
  <p class="mt-5 max-w-2xl text-lg font-light">{{ s.intro }}</p>
  <div class="mt-6 flex flex-wrap items-center gap-3">
    <a href="{{ mail }}Press%20enquiry" class="inline-flex min-h-12 items-center rounded-full bg-primary px-6 text-sm font-medium text-primary-foreground">Email the press desk</a>
    <button type="button" data-copy="{{ s.email | escape }}" class="inline-flex min-h-12 items-center gap-2 rounded-full border border-border px-5 text-sm">
      <span>{{ s.email }}</span><span class="text-muted-foreground" data-copy-label>Copy</span>
    </button>
  </div>
  <p class="mt-3 text-sm font-light text-muted-foreground">{{ s.deadline }}</p>

  {%- assign perks = s.perks | newline_to_br | split: '<br />' -%}
  <ul class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-5">
    {%- for p in perks -%}{%- assign bits = p | strip | split: '|' -%}{%- if bits[0] != blank -%}
      <li class="rounded-md bg-card p-5 md:p-6"><p class="font-heavy font-bold text-primary">{{ bits[0] | strip }}</p><p class="mt-1 text-sm font-light text-muted-foreground">{{ bits[1] | strip }}</p></li>
    {%- endif -%}{%- endfor -%}
  </ul>

  <section class="mt-16 grid gap-6 md:grid-cols-2" aria-labelledby="press-about">
    <h2 id="press-about" class="font-heavy text-3xl font-black tracking-tight text-primary md:col-span-2">about playmate labs.</h2>
    {%- for pair in (1..2) -%}
      {%- if pair == 1 -%}{%- assign label = 'Short version' -%}{%- assign text = s.short -%}{%- else -%}{%- assign label = 'Longer version' -%}{%- assign text = s.long -%}{%- endif -%}
      <div class="flex flex-col rounded-md bg-card p-6 md:p-8">
        <div class="flex items-center justify-between gap-4">
          <p class="text-[11px] font-bold uppercase tracking-[0.25em] text-muted-foreground">{{ label }}</p>
          <button type="button" data-copy="{{ text | strip_html | escape }}" class="rounded-full border border-border px-3 py-1 text-xs"><span data-copy-label>Copy</span></button>
        </div>
        <div class="pm-rte mt-4 font-light leading-relaxed">{{ text }}</div>
      </div>
    {%- endfor -%}
  </section>

  {%- assign facts = section.blocks | where: 'type', 'product' -%}
  {%- if facts.size > 0 -%}
  <section class="mt-16" aria-labelledby="press-products">
    <h2 id="press-products" class="font-heavy text-3xl font-black tracking-tight text-primary">the products.</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {%- for b in facts -%}{%- assign p = b.settings.product -%}
        <article class="flex flex-col overflow-hidden rounded-md bg-card" {{ b.shopify_attributes }}>
          {%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 900 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}" width="900" height="{{ 900 | divided_by: p.featured_image.aspect_ratio | round }}" loading="lazy" class="aspect-[4/3] w-full object-cover">{%- endif -%}
          <div class="flex flex-1 flex-col p-6 md:p-8">
            <p class="text-[11px] font-bold uppercase tracking-[0.25em] text-muted-foreground">{{ b.settings.tag }}</p>
            <h3 class="font-heavy mt-2 text-2xl font-black text-primary">{{ b.settings.title | default: p.title }}</h3>
            {%- if p -%}<p class="mt-1 text-sm">{{ p.price | money }} RRP{% unless p.available %}, back soon{% endunless %}</p>{%- endif -%}
            <div class="pm-rte mt-4 text-sm font-light leading-relaxed">{{ b.settings.facts }}</div>
            {%- if p -%}<a href="{{ p.url }}" class="mt-auto pt-5 text-sm underline underline-offset-4">View product</a>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  {%- assign imgs = section.blocks | where: 'type', 'image' -%}
  {%- if imgs.size > 0 -%}
  <section class="mt-16" aria-labelledby="press-images">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="press-images" class="font-heavy text-3xl font-black tracking-tight text-primary">images.</h2>
        <p class="mt-2 max-w-xl text-sm font-light text-muted-foreground">{{ s.images_line }}</p>
      </div>
      {%- if s.zip != blank -%}<a href="{{ s.zip }}" class="inline-flex min-h-11 items-center rounded-full border border-border px-5 text-sm">{{ s.zip_label }}</a>{%- endif -%}
    </div>
    <ul class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5">
      {%- for b in imgs -%}{%- assign im = b.settings.image -%}{%- if im -%}
        <li {{ b.shopify_attributes }}>
          <a href="{{ im | image_url: width: 4000 }}" target="_blank" rel="noopener" class="group block">
            <img src="{{ im | image_url: width: 700 }}" alt="{{ b.settings.caption | default: im.alt | escape }}" width="700" height="{{ 700 | divided_by: im.aspect_ratio | round }}" loading="lazy" class="aspect-[4/5] w-full rounded-md bg-white object-contain">
            <span class="mt-2 block text-sm">{{ b.settings.caption }}</span>
            <span class="block text-xs text-muted-foreground">{{ im.width }} × {{ im.height }}px, opens full size</span>
          </a>
        </li>
      {%- endif -%}{%- endfor -%}
    </ul>
    <p class="mt-4 text-sm font-light text-muted-foreground">{{ s.images_more }} <a href="{{ mail }}Image%20request" class="underline underline-offset-4">Ask for images</a>.</p>
  </section>
  {%- endif -%}

  <section class="mt-16 grid gap-10 md:grid-cols-2">
    <div aria-labelledby="press-founder">
      <h2 id="press-founder" class="font-heavy text-3xl font-black tracking-tight text-primary">the founder.</h2>
      <div class="pm-rte mt-4 font-light leading-relaxed">{{ s.founder }}</div>
      {%- if s.founder_url != blank -%}<a href="{{ s.founder_url }}" class="mt-3 inline-block text-sm underline underline-offset-4">Full bio</a>{%- endif -%}
    </div>
    {%- assign tools = section.blocks | where: 'type', 'tool' -%}
    {%- if tools.size > 0 -%}
    <div aria-labelledby="press-tools">
      <h2 id="press-tools" class="font-heavy text-3xl font-black tracking-tight text-primary">free tools for couples.</h2>
      <p class="mt-2 text-sm font-light text-muted-foreground">{{ s.tools_line }}</p>
      <ul class="mt-4 divide-y divide-border">
        {%- for b in tools -%}
          <li class="py-3" {{ b.shopify_attributes }}><a href="{{ b.settings.url }}" class="font-medium underline-offset-4 hover:underline">{{ b.settings.title }}</a><p class="text-sm font-light text-muted-foreground">{{ b.settings.line }}</p></li>
        {%- endfor -%}
      </ul>
    </div>
    {%- endif -%}
  </section>

  {%- assign cov = section.blocks | where: 'type', 'coverage' -%}
  {%- if cov.size > 0 -%}
  <section class="mt-16" aria-labelledby="press-coverage">
    <h2 id="press-coverage" class="font-heavy text-3xl font-black tracking-tight text-primary">coverage.</h2>
    <ul class="mt-6 divide-y divide-border border-y border-border">
      {%- for b in cov -%}
        <li class="grid gap-1 py-4 md:grid-cols-[12rem_1fr_8rem] md:items-baseline md:gap-6" {{ b.shopify_attributes }}>
          <span class="font-heavy font-bold text-primary">{{ b.settings.outlet }}</span>
          {%- if b.settings.url != blank -%}<a href="{{ b.settings.url }}" target="_blank" rel="noopener" class="font-light underline-offset-4 hover:underline">{{ b.settings.headline }}</a>{%- else -%}<span class="font-light">{{ b.settings.headline }}</span>{%- endif -%}
          <span class="text-sm text-muted-foreground md:text-right">{{ b.settings.date }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </section>
  {%- endif -%}

  <section class="mt-16 rounded-md bg-primary p-8 text-primary-foreground md:p-12" aria-labelledby="press-contact">
    {% render 'pm-note', text: s.contact_note, class: '-rotate-2 text-xl', light: true %}
    <h2 id="press-contact" class="font-heavy mt-2 text-3xl font-black tracking-tight md:text-4xl">{{ s.contact_name }}</h2>
    <p class="mt-3 font-light">{{ s.contact_line }}</p>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a href="{{ mail }}Press%20enquiry" class="inline-flex min-h-12 items-center rounded-full bg-primary-foreground px-6 text-sm font-medium text-primary">Email {{ s.email }}</a>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "Press page",
  "settings": [
    { "type": "text", "id": "note", "label": "Note", "default": "on deadline? we're quick." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "press." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Everything you need to write about Playmate Labs: facts, images and a direct line to the founder." },
    { "type": "text", "id": "deadline", "label": "Deadline line", "default": "Email with \"Press\" in the subject and we'll reply the same working day." },
    { "type": "text", "id": "email", "label": "Press email", "default": "info@playmatelabs.com" },
    { "type": "textarea", "id": "perks", "label": "Quick facts, one per line as Title|Line", "default": "Same-day replies|On deadline? We answer the same working day.\nSamples|For reviews and gift guides, on request.\nFree images|For editorial use, credit Playmate Labs.\nFounder on comment|Date nights, couples games, gifting, small UK brands." },
    { "type": "richtext", "id": "short", "label": "Boilerplate, short", "default": "<p>Playmate Labs is a UK date-night brand that makes games and treats for couples, for nights in that feel like a proper date.</p>" },
    { "type": "richtext", "id": "long", "label": "Boilerplate, long", "default": "<p>Playmate Labs was founded by Jordan Underwood on a simple observation: couples stop dating once a relationship settles in, and very little on the market helps them start again in a way that feels playful rather than awkward. The newest product, Nude Stack'd, is a date-night stacking game for two.</p>" },
    { "type": "text", "id": "images_line", "label": "Images line", "default": "Free for editorial use with credit to Playmate Labs. Click any image for the full-size file." },
    { "type": "text", "id": "images_more", "label": "Images, more line", "default": "Need a different crop, a higher-resolution file or a sample for a review?" },
    { "type": "url", "id": "zip", "label": "Download all images (ZIP)" },
    { "type": "text", "id": "zip_label", "label": "ZIP button", "default": "Download all images (ZIP)" },
    { "type": "richtext", "id": "founder", "label": "Founder", "default": "<p>Jordan Underwood founded Playmate Labs after seven years in recruitment, a job built on understanding what people actually want. Jordan leads product design, writes The Playmate Journal, and comments on date-night trends, couples games, gifting and building a small UK brand.</p>" },
    { "type": "url", "id": "founder_url", "label": "Founder bio link" },
    { "type": "text", "id": "tools_line", "label": "Free tools line", "default": "Free to use, link to or embed in your coverage." },
    { "type": "text", "id": "contact_note", "label": "Contact note", "default": "say hello." },
    { "type": "text", "id": "contact_name", "label": "Contact name", "default": "Jordan Underwood, founder" },
    { "type": "text", "id": "contact_line", "label": "Contact line", "default": "Interviews, samples, images and comment. We reply the same working day." }
  ],
  "blocks": [
    { "type": "product", "name": "Product fact sheet", "settings": [
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "text", "id": "tag", "label": "Label", "default": "Featured product" },
      { "type": "text", "id": "title", "label": "Title (optional)" },
      { "type": "richtext", "id": "facts", "label": "Facts" } ] },
    { "type": "image", "name": "Press image", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "caption", "label": "Caption" } ] },
    { "type": "tool", "name": "Free tool", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "url", "id": "url", "label": "Link" },
      { "type": "text", "id": "line", "label": "Line" } ] },
    { "type": "coverage", "name": "Coverage", "settings": [
      { "type": "text", "id": "outlet", "label": "Outlet" },
      { "type": "text", "id": "headline", "label": "Headline or description" },
      { "type": "url", "id": "url", "label": "Link" },
      { "type": "text", "id": "date", "label": "Date" } ] }
  ],
  "presets": [{ "name": "Press page" }]
}
{% endschema %}
