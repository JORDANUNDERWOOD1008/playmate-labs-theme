      "id": "pad_bottom_mobile",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom — mobile",
      "default": 96
    },
    {
      "type": "header",
      "content": "✍️ Text placement"
    },
    {
      "type": "select",
      "id": "text_align_desktop",
      "label": "Alignment — desktop",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Alignment — mobile",
      "options": [
        {
          "value": "",
          "label": "Theme default"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
