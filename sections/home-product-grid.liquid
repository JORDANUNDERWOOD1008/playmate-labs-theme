{% render 'section-style', section: section %}
{% comment %}
  PLAYMATE LABS — HOME PRODUCT GRID SECTION
  File: sections/home-product-grid.liquid
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} .home-products {
    --card-cols-mobile: {{ section.settings.mobile_columns }};
    --card-gap-mobile: {{ section.settings.mobile_gap }}px;
    --card-w-mobile: {{ section.settings.mobile_card_width }}vw;
    --card-cta-bg: {{ section.settings.card_cta_bg }};
    --card-cta-fg: {{ section.settings.card_cta_fg }};
    --card-qa-bg: {{ section.settings.card_qa_bg }};
    --card-qa-fg: {{ section.settings.card_qa_icon }};
    --card-star-color: {{ section.settings.card_star_color }};
    --card-viewall-bg: {{ section.settings.viewall_tile_bg }};
    --card-viewall-fg: {{ section.settings.viewall_tile_text }};
    --card-viewall-dot: {{ section.settings.viewall_tile_dot }};
    --card-viewall-dot-fg: {{ section.settings.viewall_tile_dot_icon }};
    --card-align: {{ section.settings.card_text_align }};
    --card-align-flex: {% if section.settings.card_text_align == 'center' %}center{% elsif section.settings.card_text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
  }
  #shopify-section-{{ section.id }} .home-products .btn-secondary {
    background-color: {{ section.settings.viewall_btn_bg }};
    color: {{ section.settings.viewall_btn_label_color }};
    border: 1px solid {{ section.settings.viewall_btn_border }};
  }
{%- endstyle -%}
<section class="section home-products home-products--{{ section.settings.mobile_layout }}" id="shop-preview">
  <div class="container">
    {%- comment -%}
      No `default:` fallback here on purpose: clearing the fields in the
      editor has to actually remove the header, not silently restore
      placeholder copy.
    {%- endcomment -%}
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="section-header reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="heading-xl">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.show_divider -%}<div class="section-divider"></div>{%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Category Pills {%- endcomment -%}
    {%- comment -%}
      Only worth showing once there is something to filter between. With no
      category blocks this rendered a single "All" pill, which is noise.
    {%- endcomment -%}
    {%- assign category_blocks = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'category' -%}{%- assign category_blocks = category_blocks | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
    {%- if category_blocks > 0 -%}
    <div class="shop-category-pills">
      <button class="category-pill active" data-filter="all">All</button>
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <button class="category-pill" data-filter="{{ block.settings.filter_value | handleize }}">
            {{ block.settings.label }}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif -%}

    {%- liquid
      assign grid_collection = collections[section.settings.collection]
      assign grid_products = collections.all.products
      assign grid_limit = 8
      if grid_collection != blank
        assign grid_products = grid_collection.products
        assign grid_limit = section.settings.products_limit
      endif
      assign viewall_href = section.settings.view_all_url | default: routes.all_products_collection_url
    -%}

    <div class="product-grid product-grid-{{ section.settings.desktop_columns }}">
      {%- for product in grid_products limit: grid_limit -%}
        {% render 'product-card',
           product: product,
           show_badge: section.settings.card_show_badge,
           show_quick_add: section.settings.card_show_quick_add,
           show_cat: section.settings.card_show_category,
           show_desc: section.settings.card_show_desc,
           show_rating: section.settings.card_show_rating,
           show_cta: section.settings.card_show_cta,
           cta_text: section.settings.card_cta_text %}
      {%- endfor -%}

      {%- comment -%}
        "View all" rides in the grid as its own tile rather than a separate
        band underneath, which is what was leaving a dead strip on mobile.
      {%- endcomment -%}
      {%- if section.settings.viewall_style == 'tile' -%}
        <article class="product-card product-card--viewall">
          <a href="{{ viewall_href }}" class="product-card-link">
            <span class="viewall-arrow" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
              </svg>
            </span>
            <span class="viewall-label">{{ section.settings.view_all_text | default: 'View all products' }}</span>
          </a>
        </article>
      {%- endif -%}
    </div>

    {%- if section.settings.viewall_style == 'button' -%}
      <div style="text-align:center;margin-top:3rem;" class="reveal">
        <a href="{{ viewall_href }}" class="btn btn-secondary btn-lg">
          {{ section.settings.view_all_text | default: 'View All Products' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product Grid",
  "blocks": [
    {
      "type": "category",
      "name": "Category Filter",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Kits"
        },
        {
          "type": "text",
          "id": "filter_value",
          "label": "Filter value (matches product type)",
          "default": "date-night-kits"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Collection",
      "info": "Leave blank to hide the section header entirely."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rituals worth staying in for.",
      "info": "Leave blank to hide the section header entirely."
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider under the header",
      "default": true
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to display"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 4,
      "max": 12,
      "step": 2,
      "default": 8,
      "label": "Number of products"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all link text",
      "default": "View All Products"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all link URL"
    },
    {
      "type": "header",
      "content": "🔘 View-all button"
    },
    {
      "type": "color",
      "id": "viewall_btn_bg",
      "label": "Background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "viewall_btn_label_color",
      "label": "Text",
      "default": "#6B1E3A"
    },
    {
      "type": "color",
      "id": "viewall_btn_border",
      "label": "Border",
      "default": "#6B1E3A"
    },
    {
