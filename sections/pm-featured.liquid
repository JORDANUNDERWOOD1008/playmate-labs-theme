{%- assign c = section.settings.collection | default: collections.all -%}
<section class="mx-auto max-w-6xl px-5 pt-16 md:px-6 md:pt-24">
  <div class="mb-10 flex flex-wrap items-end justify-between gap-2">
    <h2 class="font-heavy text-4xl font-black tracking-tight text-primary md:text-5xl">{{ section.settings.heading }}</h2>
    <a href="{{ routes.all_products_collection_url }}" class="text-xs font-bold uppercase tracking-[0.25em] text-primary underline underline-offset-8">{{ section.settings.link }}</a>
  </div>
  <div class="no-scrollbar -mx-5 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:gap-6 md:overflow-visible md:px-0 lg:grid-cols-3">
    {%- comment -%} Order: products in the Card photos blocks first (drag them to reorder), then the rest of the collection. {%- endcomment -%}
    {%- assign shown = 0 -%}{%- assign used = ',' -%}
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      {%- if p != blank and p.available != nil and shown < section.settings.limit -%}
        {%- assign key = ',' | append: p.id | append: ',' -%}
        {%- unless used contains key -%}
          <div class="w-[72%] shrink-0 snap-start md:w-auto" {{ block.shopify_attributes }}>{% render 'pm-product-card', p: p, cover_img: block.settings.cover, hover_img: block.settings.rollover %}</div>
          {%- assign used = used | append: p.id | append: ',' -%}{%- assign shown = shown | plus: 1 -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
    {%- for p in c.products -%}
      {%- assign key = ',' | append: p.id | append: ',' -%}
      {%- if shown < section.settings.limit -%}{%- unless used contains key -%}
        <div class="w-[72%] shrink-0 snap-start md:w-auto">{% render 'pm-product-card', p: p %}</div>
        {%- assign used = used | append: p.id | append: ',' -%}{%- assign shown = shown | plus: 1 -%}
      {%- endunless -%}{%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Products row",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "made for two." },
    { "type": "text", "id": "link", "label": "Link text", "default": "View all" },
    { "type": "collection", "id": "collection", "label": "Products from" },
    { "type": "range", "id": "limit", "label": "How many", "min": 2, "max": 9, "step": 1, "default": 3 }
  ],
  "blocks": [{ "type": "card", "name": "Card photos", "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Cards show in the order of these blocks. Drag to reorder." },
    { "type": "image_picker", "id": "cover", "label": "Main photo", "info": "Empty = the default photo." },
    { "type": "image_picker", "id": "rollover", "label": "Rollover photo", "info": "Shown when someone hovers over the card. Empty = the default." }
  ]}],
  "presets": [{ "name": "Products row" }]
}
{% endschema %}
