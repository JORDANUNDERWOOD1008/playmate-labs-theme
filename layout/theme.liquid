<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta name="p:domain_verify" content="e85f8f4d9852c145521e98cb0a205f9d"/>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#72101F">
  <meta name="msvalidate.01" content="DD22E6752A61891AC89B366341673A50" />

  {%- comment -%} ══ GOOGLE CONSENT MODE v2 — must be FIRST script ══ {%- endcomment -%}
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      'analytics_storage': 'denied',
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'functionality_storage': 'granted',
      'security_storage': 'granted',
      'wait_for_update': 500
    });
  </script>

  {%- comment -%} ══ DATA LAYER ══ {%- endcomment -%}
  {% render 'datalayer' %}

  {%- comment -%} ══ GOOGLE TAG MANAGER — head ══
       Replace GTM-NXMGJ6W7 with your container ID
       Create at: https://tagmanager.google.com
  {%- endcomment -%}
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-NXMGJ6W7');</script>
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {%- unless settings.font_heading.system? and settings.font_body.system? -%}
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
  {%- endunless -%}


  {%- comment -%} ══ TITLE TAG — per-template with 70-char limit awareness ══ {%- endcomment -%}
  <title>
    {%- if template == 'index' -%}
      Playmate Labs — Date Night Experiences &amp; Couples Rituals
    {%- elsif template == 'list-collections' -%}
      Shop All Collections | Playmate Labs
    {%- elsif template == 'search' -%}
      Search | Playmate Labs
    {%- elsif template == '404' -%}
      Page Not Found | Playmate Labs
    {%- elsif template == 'cart' -%}
      Your Shopping Cart | Playmate Labs
    {%- elsif template == 'blog' -%}
      {%- if current_tags -%}
        {{ current_tags | join: ', ' }} | {{ blog.title }}
      {%- else -%}
        {{ blog.title }} | Playmate Labs
      {%- endif -%}
    {%- elsif template == 'article' -%}
      {%- comment -%} page_title = the SEO title set in admin, falling back to the article title.
      Never chop mid-word; only append the brand when the result still fits in a SERP. {%- endcomment -%}
      {%- assign seo_title = page_title | default: article.title -%}
      {%- if seo_title contains 'Playmate Labs' -%}
        {{ seo_title }}
      {%- elsif seo_title.size <= 43 -%}
        {{ seo_title }} | Playmate Labs
      {%- else -%}
        {{ seo_title }}
      {%- endif -%}
    {%- elsif template contains 'product' -%}
      {%- comment -%} Same rule as articles: the admin SEO title wins, never chop mid-word,
      and only append the brand when it still fits. Previously the admin title was ignored,
      so Snap'd showed as "Snap'd - Choc Hearts" while ranking 3.8 for "aphrodisiac chocolate". {%- endcomment -%}
      {%- assign seo_title = page_title | default: product.title -%}
      {%- if seo_title contains 'Playmate Labs' -%}
        {{ seo_title }}
      {%- elsif seo_title.size <= 43 -%}
        {{ seo_title }} | Playmate Labs
      {%- else -%}
        {{ seo_title }}
      {%- endif -%}
    {%- else -%}
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged &quot;{{ current_tags | join: ', ' }}&quot;{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains 'Playmate Labs' or page_title contains 'playmatelabs' %} | Playmate Labs{% endunless -%}
    {%- endif -%}
  </title>

  {%- comment -%} ══ META DESCRIPTIONS — template-specific checks first, then page_description fallback ══ {%- endcomment -%}
  {% if template == 'index' %}
    <meta name="description" content="Aphrodisiac chocolates and date-night games for couples: Snap'd chocolate hearts, Melt'd hot choc spoons and the Nude Stack'd game. Designed in the UK.">
  {% elsif template == 'list-collections' %}
    <meta name="description" content="Explore all Playmate Labs collections: aphrodisiac chocolates, date-night games and couples gift bundles. Chocolate handcrafted in the UK.">
  {% elsif template == 'search' %}
    <meta name="description" content="Search Playmate Labs for aphrodisiac chocolates, hot chocolate spoons, date night products, couples gifts and journal articles.">
  {% elsif template == 'blog' %}
    <meta name="description" content="{{ blog.title | escape }} — expert guides on aphrodisiac ingredients, date night ideas, intimacy tips and couples wellness from Playmate Labs.">
  {% elsif template == 'article' %}
    {%- comment -%} The admin-set description wins. The excerpt is a fallback only, and uses the
    hand-written excerpt rather than the body, so it never cuts off mid-sentence. {%- endcomment -%}
    {% if page_description != blank %}
      <meta name="description" content="{{ page_description | escape }}">
    {% elsif article.excerpt != blank %}
      <meta name="description" content="{{ article.excerpt | strip_html | strip_newlines | escape }}">
    {% else %}
      <meta name="description" content="{{ article.title | escape }} — read more on The Playmate Journal by Playmate Labs.">
    {% endif %}
  {% elsif template.name == 'page' and page.handle == 'faq' %}
    <meta name="description" content="Frequently asked questions about Playmate Labs aphrodisiac chocolates — ingredients, shipping, dietary info and how our products work.">
  {% elsif template.name == 'page' and page.handle == 'contact' %}
    <meta name="description" content="Get in touch with Playmate Labs — questions about orders, ingredients, partnerships or wholesale. UK-based team ready to help.">
  {% elsif template.name == 'page' and page.handle == 'sms-opt-in' %}
    <meta name="description" content="Sign up for Playmate Labs texts. Be first to hear about new products and offers.">
  {% elsif page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% elsif template == 'collection' %}
    <meta name="description" content="Browse {{ collection.title | escape }} from Playmate Labs. Aphrodisiac chocolates, date night kits and sensory products designed for couples.">
  {% elsif template == 'cart' %}
    <meta name="description" content="Review and complete your Playmate Labs order. Free UK shipping on orders of £49 or more.">
  {% elsif template == '404' %}
    <meta name="description" content="This page could not be found. Browse Playmate Labs for aphrodisiac chocolates, date night kits and couples experiences.">
  {% elsif request.path contains '/policies/' %}
    <meta name="description" content="{{ page_title | escape }} for Playmate Labs. Read our terms covering orders, shipping, returns and privacy.">
  {% else %}
    <meta name="description" content="{{ page_title | escape }} | Playmate Labs — aphrodisiac chocolates, date night experiences and couples products.">
  {% endif %}

  {%- comment -%} ══ NOINDEX — non-content utility pages ══ {%- endcomment -%}
  {%- comment -%} current_tags = a blog tag page: thin, duplicate listings of posts that are
  already indexed on their own. ~20 of these were in the index earning 1-13 impressions each. {%- endcomment -%}
  {%- if template == '404' or template == 'cart' or request.path contains '/policies/' or current_tags or template.suffix == 'wholesale' or template.suffix == 'stockist-login' -%}
    <meta name="robots" content="noindex, follow">
  {%- endif -%}

  {% render 'meta-tags' %}

  {{ content_for_header }}

  {%- comment -%}
    Cinematic theme (Oct 2026): Figtree for the heavy lowercase headings, Jost for body copy and
    Homemade Apple for the handwritten notes. Every utility class comes from cinematic.css, which
    is compiled with Tailwind from the sections named pm-*. Rebuild it with
    cinematic-site/build/build.sh after changing classes in those sections.
  {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Homemade+Apple&family=Figtree:wght@400;500;700;900&display=swap">
  {{ 'cinematic.css' | asset_url | stylesheet_tag }}

  {%- comment -%}
    Pages not rebuilt in the cinematic design yet (customer accounts, SMS opt-in, Bloggle posts)
    still load the old stylesheets so they look as they do today. Phase 2 restyles them.
  {%- endcomment -%}
  {%- if template.directory == 'customers' or template.suffix == 'sms-opt-in' or template.suffix contains 'bloggle' -%}
    {{ 'global.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {% render 'theme-css-variables' %}
    {%- if template.directory == 'customers' -%}{{ 'account.css' | asset_url | stylesheet_tag }}{%- endif -%}
    {%- if template.suffix contains 'bloggle' -%}{{ 'journal.css' | asset_url | stylesheet_tag }}{%- endif -%}
  {%- endif -%}

  <script>
    // Theme feature flags
    window.Shopify = window.Shopify || {};
    window.playmatelabs = {
      currency: {{ cart.currency.iso_code | json }},
      moneyFormat: {{ shop.money_format | json }},
      cartToken: {{ cart.token | json }},
      customerId: {{ customer.id | default: 'null' | json }},
      shopName: {{ shop.name | json }}
    };
  </script>

  {%- comment -%} === STRUCTURED DATA / SCHEMA MARKUP === {%- endcomment -%}
  {% render 'schema-organization' %}
  {%- if request.page_type == 'product' -%}{% render 'schema-product', product: product %}{%- endif -%}
  {%- if request.page_type == 'article' -%}{% render 'schema-article', article: article, blog: blog %}{%- endif -%}
  {% render 'schema-breadcrumbs' %}
  {% render 'schema-faq' %}
</head>

<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %} antialiased">

  {%- comment -%} Google Tag Manager — noscript fallback {%- endcomment -%}
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NXMGJ6W7" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-primary focus:px-5 focus:py-3 focus:text-primary-foreground" href="#MainContent">Skip to content</a>

  {% section 'pm-header' %}
  {% section 'pm-cart-drawer' %}

  <main id="MainContent" role="main" tabindex="-1" class="focus:outline-none">
    {{ content_for_layout }}
  </main>

  {% section 'pm-footer' %}

  <script>
    window.PM = {
      klaviyoKey: {{ settings.klaviyo_public_api_key | default: '' | json }},
      lists: {
        fiveDay: {{ settings.klaviyo_experience_list_id | default: settings.klaviyo_popup_list_id | default: '' | json }},
        news: {{ settings.klaviyo_footer_list_id | default: settings.klaviyo_popup_list_id | default: '' | json }}
      },
      freeShipping: {{ settings.pm_free_shipping | default: 4900 }}
    };
  </script>
  <script src="{{ 'cinematic.js' | asset_url }}" defer></script>

  {%- comment -%} "Try your luck?" scratch card. Switch off in the theme editor: Scratch card → Show the scratch card. {%- endcomment -%}
  {% section 'pm-scratch' %}

  {%- comment -%} Cookie Consent Banner {%- endcomment -%}
  {% render 'shopify-consent-bridge' %}

</body>
</html>
