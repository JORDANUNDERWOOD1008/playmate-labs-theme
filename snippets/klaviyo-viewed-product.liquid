{% comment %}
  Klaviyo "Viewed Product" (metric Sa8QMW), which triggers the Browse abandonment flow (UP2C4P).
  Added 4 Nov 2026: the event had never fired since March; the app embed loads klaviyo.js
  but nothing sent product views. Klaviyo only records it for visitors it already knows
  (clicked a Klaviyo email, or signed up on this browser: see identify in cinematic.js).
  Field names follow Klaviyo's Shopify snippet so the flow's dynamic product blocks work.
{% endcomment %}
{%- if product -%}
<script>
  (function () {
    var klaviyo = window.klaviyo = window.klaviyo || [];
    var item = {
      Name: {{ product.title | json }},
      ProductID: {{ product.id | json }},
      Categories: {{ product.collections | map: 'title' | json }},
      ImageURL: {{ product.featured_image | image_url: width: 800 | prepend: 'https:' | json }},
      URL: {{ product.url | prepend: request.origin | json }},
      Brand: {{ product.vendor | json }},
      Price: {{ product.price | money_without_currency | remove: ',' | json }},
      CompareAtPrice: {{ product.compare_at_price_max | money_without_currency | remove: ',' | json }}
    };
    klaviyo.push(['track', 'Viewed Product', item]);
    klaviyo.push(['trackViewedItem', {
      Title: item.Name,
      ItemId: item.ProductID,
      Categories: item.Categories,
      ImageUrl: item.ImageURL,
      Url: item.URL,
      Metadata: { Brand: item.Brand, Price: item.Price, CompareAtPrice: item.CompareAtPrice }
    }]);
  })();
</script>
{%- endif -%}
