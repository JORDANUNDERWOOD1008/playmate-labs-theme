{%- comment -%}
  PLAYMATE LABS — PRODUCT CARD SNIPPET
  File: snippets/product-card.liquid

  Usage:
    {% render 'product-card', product: product %}

  Optional params (all default to the "clean" card — title, price, CTA):
    show_badge      false to suppress the sale / sold-out / new-drop badges
    show_quick_add  false to suppress the hover quick-add
    show_cat        true to print the category line above the title
    show_desc       true to print a short description under the title
    show_rating     true to print stars (only renders if the metafields exist)
    show_cta        false to suppress the "Shop now" pill
    cta_text        label for that pill
{%- endcomment -%}

{%- liquid
  assign show_badge     = show_badge     | default: true,  allow_false: true
  assign show_quick_add = show_quick_add | default: true,  allow_false: true
  assign show_cat       = show_cat       | default: false, allow_false: true
  assign show_desc      = show_desc      | default: false, allow_false: true
  assign show_rating    = show_rating    | default: false, allow_false: true
  assign show_cta       = show_cta       | default: true,  allow_false: true
  assign cta_text       = cta_text       | default: 'Shop now'
  assign badge_label    = product.metafields.custom.badge_label | default: ''

  # Price and compare-at must come from ONE variant. Reading product.price
  # (the cheapest variant) against product.compare_at_price (the cheapest
  # non-null compare-at, often a different variant) invents a discount that
  # no variant actually offers.
  assign cvar = product.selected_or_first_available_variant | default: product.variants.first
  assign card_price   = cvar.price
  assign card_compare = cvar.compare_at_price

  # A card image can differ from the product's first image. Set the metafield
  # custom.card_image on a product and the card uses that, leaving the product
  # page free to lead with a different shot.
  assign card_img = product.metafields.custom.card_image.value | default: product.featured_image
  assign hover_img = product.images[1]
  if card_img == product.images[1] and product.images[2]
    assign hover_img = product.images[2]
  endif

  assign rating       = product.metafields.custom.rating
  assign rating_count = product.metafields.custom.rating_count
-%}

<article class="product-card" data-product-id="{{ product.id }}">
  <a href="{{ product.url }}" class="product-card-link" aria-label="{{ product.title | escape }}">

    <div class="product-card-img">
      {%- if card_img -%}
        <img
          src="{{ card_img | image_url: width: 600 }}"
          alt="{{ card_img.alt | default: product.title | escape }}"
          width="600"
          height="600"
          loading="lazy"
          class="product-img-main">
        {%- if hover_img -%}
          <img
            src="{{ hover_img | image_url: width: 600 }}"
            alt="{{ hover_img.alt | default: product.title | escape }}"
            width="600"
            height="600"
            loading="lazy"
            class="product-img-hover">
        {%- endif -%}
      {%- else -%}
        <div class="img-placeholder" style="aspect-ratio:1;">
          <span style="font-size:3rem;position:relative;z-index:1;">
            {%- case product.type -%}
              {%- when 'Consumables' -%}🍫
              {%- when 'Candles' -%}🕯️
              {%- when 'Games' -%}🃏
              {%- when 'Date Night Kits' -%}🌹
              {%- else -%}✨
            {%- endcase -%}
          </span>
        </div>
      {%- endif -%}

      {%- if show_badge -%}
        <div class="product-card-badges">
          {%- if product.available == false -%}
            <span class="badge badge-dark">Sold Out</span>
          {%- elsif product.metafields.custom.is_new_drop == '1' -%}
            <span class="badge badge-gold">New Drop</span>
          {%- elsif card_compare > card_price -%}
            {%- assign savings = card_compare | minus: card_price -%}
            <span class="badge badge-burgundy">Save {{ savings | money }}</span>
          {%- elsif badge_label != '' -%}
            <span class="badge badge-burgundy">{{ badge_label }}</span>
          {%- endif -%}
          {%- if product.metafields.custom.limited_qty -%}
            <span class="badge badge-dark">Limited</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if show_quick_add and product.available -%}
        <button
          class="product-card-quick-add"
          type="button"
          data-variant-id="{{ product.first_available_variant.id }}"
          data-product-name="{{ product.title | escape }}"
          aria-label="Quick add {{ product.title | escape }} to cart">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
        </button>
      {%- endif -%}
    </div>

    <div class="product-card-info">
      {%- if show_cat -%}
        {%- assign cat = product.metafields.custom.category | default: product.type -%}
        {%- if cat != blank -%}<p class="product-card-cat">{{ cat }}</p>{%- endif -%}
      {%- endif -%}

      <h3 class="product-card-title">{{ product.title }}</h3>

      {%- if show_rating and rating != blank -%}
        <p class="product-card-rating">
          <span class="product-card-stars" aria-hidden="true">
            {%- assign whole = rating | round -%}
            {%- for i in (1..5) -%}{% if i <= whole %}★{% else %}☆{% endif %}{%- endfor -%}
          </span>
          {%- if rating_count != blank -%}
            <span class="product-card-rating-count">({{ rating_count }})</span>
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if show_desc -%}
        {%- assign blurb = product.metafields.custom.short_desc -%}
        {%- if blurb != blank -%}
          <p class="product-card-desc">{{ blurb }}</p>
        {%- endif -%}
      {%- endif -%}

      <div class="product-card-price-row">
        <div class="product-card-price">
          <span class="price-current">{{ card_price | money }}</span>
          {%- if card_compare > card_price -%}
            <span class="price-original">{{ card_compare | money }}</span>
          {%- endif -%}
        </div>
      </div>

      {%- if show_cta -%}
        <span class="product-card-cta">
          {%- if product.available -%}{{ cta_text }}{%- else -%}Sold out{%- endif -%}
        </span>
      {%- endif -%}
    </div>
  </a>
</article>
