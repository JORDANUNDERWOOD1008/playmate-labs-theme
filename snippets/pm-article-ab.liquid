{%- comment -%} Blog CTA A/B test (blog_cta_v2), moved unchanged from templates/article.liquid. Shows #ab-cta-card for variant B and reports to GA4. {%- endcomment -%}
<!-- A/B TEST: Blog CTA Card v1 — variant assignment + GA4 tracking -->
<script>
(function(){
  var TEST_NAME = 'blog_cta_v2';
  var COOKIE_NAME = 'ab_' + TEST_NAME;
  var EXPIRY_DAYS = 42;

  function getCookie(name) {
    var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
    return match ? match[2] : null;
  }

  function setCookie(name, value, days) {
    var d = new Date();
    d.setTime(d.getTime() + days * 86400000);
    document.cookie = name + '=' + value + ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
  }

  function gaEvent(name, params) {
    if (typeof gtag === 'function') {
      gtag('event', name, params);
    }
  }

  // Assign or retrieve variant
  var variant = getCookie(COOKIE_NAME);
  if (!variant) {
    variant = Math.random() < 0.5 ? 'control' : 'cta_card';
    setCookie(COOKIE_NAME, variant, EXPIRY_DAYS);
  }

  // Fire impression event
  gaEvent('ab_test_view', {
    test_name: TEST_NAME,
    variant: variant,
    page_path: window.location.pathname
  });

  // Show CTA card for variant B
  if (variant === 'cta_card') {
    var card = document.getElementById('ab-cta-card');
    if (card) card.style.display = '';

    // Track CTA click
    var btn = document.getElementById('ab-cta-btn');
    if (btn) {
      btn.addEventListener('click', function() {
        gaEvent('ab_cta_click', {
          test_name: TEST_NAME,
          variant: variant,
          product: (card && card.getAttribute('data-product')) || '',
          page_path: window.location.pathname
        });
      });
    }
  }
})();
</script>
