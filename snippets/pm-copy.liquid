{%- comment -%}
  Product copy from the cinematic site, keyed by product handle. A product metafield in the
  custom namespace overrides each field when it is filled in (card_tag, card_desc, intro, and
  glance / in_box / how_to as one line per item).
  Usage: {% render 'pm-copy', product: product, field: 'tag' %}
  Fields: tag, desc, intro, glance, in_box, how_to (lists render as <li>), cover, hover, extra_images (asset names), category,
  faq (raw 'Question::Answer|Question::Answer', rendered on the product page and as FAQPage schema)
  cover = a theme asset shown as the card's main photo instead of the product's featured image (the featured image then becomes the rollover).
{%- endcomment -%}
{%- liquid
  assign h = product.handle
  assign tag = '' 
  assign desc = ''
  assign intro = ''
  assign glance = ''
  assign in_box = ''
  assign how_to = ''
  assign hover = ''
  assign cover = ''
  assign extra = ''
  assign faq = ''
  case h
    when 'nude-stacked'
      assign tag = 'New in'
      assign desc = 'The stacking game that turns a quiet night into a long one.'
      assign intro = 'A date-night stacking game for two. Pull a block, draw a prompt card and pick a level, from easy to a little bolder. Made for adults (18+). Anyone can pass.'
      assign glance = 'Pull a block, match its symbol to a card, choose one of three levels.|A game lasts anything from five minutes to two hours.|House rule: either of you can skip any card, any time.|Companion app with every card in six languages.'
      assign in_box = '54 red wooden blocks — 37 with symbols, 17 "?" wild blocks|54 prompt cards, three levels each (162 prompts)|Soft eye mask|Drawstring travel bag|Gift box, ready to give'
      assign how_to = 'Build the tower together, three blocks a layer.|Take turns pulling a block. One hand, no rushing.|Match the symbol and draw a card. "?" is wild.|Choose your level. Do it, or pass.|Place the block on top and hand over.|When the tower falls, rebuild — or call it a night.'
      assign cover = 'pm-hot-blocks.webp'
      assign extra = 'pm-hot-blocks.webp|pm-hot-blindfold.webp'
    when 'playmate-chocolate'
      assign tag = 'The original'
      assign desc = 'Vanilla, hot honey and black raspberry. Made to be broken in half.'
      assign intro = 'Aphrodisiac milk chocolate hearts in three flavours: vanilla, hot honey and black raspberry. One heart, two halves — share it.'
      assign glance = 'Three hearts per box.|Vanilla · Hot honey · Black raspberry.|Made in the UK.|Arrives in discreet packaging.'
      assign hover = ''
      assign extra = ''
      assign faq = "What is Snap'd?::Three milk chocolate hearts in vanilla, hot honey and black raspberry, made in the UK and designed to be snapped in half and shared. Each heart contains Liboost® Damiana extract, zinc, vitamin B6 and selenium, and Snap'd is classified as a food supplement.|How do you eat them?::Snap one heart in half and share it. Half a heart each is one serving, so one box covers three evenings for two. Do not exceed the stated dose.|What's in them?::Colombian milk chocolate (41% cocoa solids) with Liboost® Damiana extract, zinc, vitamin B6 and selenium. The full ingredients and the amounts per serving are under Ingredients and allergens on this page.|Are they vegan? What about allergens?::They are suitable for vegetarians but not vegans. They contain milk and soya, and may contain traces of nuts.|Who shouldn't eat them?::Not recommended if you are pregnant, trying for a baby or breastfeeding, or for anyone under 18. If you take medication or have a medical condition, check with your GP or pharmacist first.|Do they make a good gift?::Yes. Snap'd comes gift-boxed and ships in plain packaging, so nothing on the outside of the parcel gives it away.|How long does delivery take?::Standard UK delivery takes 2 to 4 working days for orders placed before 6pm, and it's free on orders from £49 (£5.99 below that). Express next day delivery is £7.99 if you order by 2pm."
    when 'aphrodisiac-hot-chocolate-spoons'
      assign tag = '4 pack'
      assign desc = 'Aphrodisiac hot chocolate on a spoon.'
      assign intro = 'Stir into hot milk and watch it melt. Four aphrodisiac hot chocolate spoons for slow evenings in.'
      assign glance = 'Four spoons per pack.|Stir into 200ml hot milk.|Back soon — join the list for the restock.'
      assign hover = 'pm-hot-spoon.webp'
      assign extra = 'pm-hot-spoon.webp'
  endcase
  assign m = product.metafields.custom
  if m.card_tag != blank
    assign tag = m.card_tag.value
  endif
  if m.card_desc != blank
    assign desc = m.card_desc.value
  endif
  if m.intro != blank
    assign intro = m.intro.value
  endif
  if m.glance != blank
    assign glance = m.glance.value | newline_to_br | replace: '<br />', '|' | strip_newlines
  endif
  if m.in_box != blank
    assign in_box = m.in_box.value | newline_to_br | replace: '<br />', '|' | strip_newlines
  endif
  if m.how_to != blank
    assign how_to = m.how_to.value | newline_to_br | replace: '<br />', '|' | strip_newlines
  endif
  if desc == blank
    assign desc = product.description | strip_html | truncatewords: 14
  endif
  if intro == blank
    assign intro = product.description | strip_html | truncatewords: 60
  endif
  if tag == blank and product.type != blank
    assign tag = product.type
  endif
-%}
{%- case field -%}
  {%- when 'tag' -%}{{ tag }}
  {%- when 'desc' -%}{{ desc }}
  {%- when 'intro' -%}{{ intro }}
  {%- when 'hover' -%}{% if hover != blank %}{{ hover | asset_url }}{% endif %}
  {%- when 'cover' -%}{% if cover != blank %}{{ cover | asset_url }}{% endif %}
  {%- when 'extra_images' -%}{{ extra }}
  {%- when 'faq' -%}{{ faq }}
  {%- when 'category' -%}{% if product.type == 'Games' or product.tags contains 'game' %}games{% else %}chocolate{% endif %}
  {%- when 'glance', 'in_box', 'how_to' -%}
    {%- case field -%}{%- when 'glance' -%}{%- assign list = glance -%}{%- when 'in_box' -%}{%- assign list = in_box -%}{%- else -%}{%- assign list = how_to -%}{%- endcase -%}
    {%- assign items = list | split: '|' -%}
    {%- for x in items -%}{%- assign x = x | strip -%}{%- if x != blank -%}<li>{{ x }}</li>{%- endif -%}{%- endfor -%}
{%- endcase -%}
