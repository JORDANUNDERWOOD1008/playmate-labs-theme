{%- comment -%}
  FAQPage schema for product pages. The questions come from the 'faq' field in snippets/pm-copy, the same
  text shown in the Questions accordion on the page, so the two always match.
{%- endcomment -%}
{%- if request.page_type == 'product' -%}
  {%- capture faq -%}{% render 'pm-copy', product: product, field: 'faq' %}{%- endcapture -%}
  {%- assign faq = faq | strip -%}
  {%- if faq != blank -%}
    {%- assign qs = faq | split: '|' -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
{%- for qa in qs -%}{%- assign parts = qa | split: '::' -%}
{"@type":"Question","name":{{ parts[0] | strip | json }},"acceptedAnswer":{"@type":"Answer","text":{{ parts[1] | strip | json }}}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]}
</script>
  {%- endif -%}
{%- endif -%}
